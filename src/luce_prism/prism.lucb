pub let codec_adapter_type = custom_codecs.codec_adapter_type
pub type TextProjection = projection.TextProjection
pub let text_projection_type = projection.text_projection_type

pub func decode_diagnosed(bytes: const u8[], codec: codecs.Codec = codecs.Codec.auto) -> interop.Reference[DecodeResult]!:
    return try diagnostics.decode_diagnosed(bytes, codec)
pub type Logic = logic.Logic
pub type Justification = logic.Justification
pub let logic_type = logic.logic_type
pub let justification_type = logic.justification_type

pub func conclude(doc: interop.Reference[Document], atom: interop.Reference[atoms.Atom]) -> atoms.ProofTag!:
    return try logic.conclude(doc, atom)

pub func why(doc: interop.Reference[Document], atom: interop.Reference[atoms.Atom]) -> interop.Reference[Justification]!:
    return try logic.why(doc, atom)

pub func derive(doc: interop.Reference[Document]) -> interop.Reference[Document]!:
    return try logic.derive(doc)

pub func parse_surface(source: str) -> interop.Reference[Document]!:
    return try document.own_document(try surface_parser.parse(source))

pub func serialize_surface(doc: interop.Reference[Document]) -> interop.Reference[storage.Blob]!:
    return try storage.own_blob(try surface_writer.write((try doc.get()).view_data()))

