## Prism's format substrate. No rendering, image codecs, or platform policy.
import memory
import interop
import strings
import math
import files
import c

pub let invalid: ErrorCode = ErrorCode.package(180)
pub let limit_exceeded: ErrorCode = ErrorCode.package(181)
pub let missing: ErrorCode = ErrorCode.package(182)
pub let unsupported: ErrorCode = ErrorCode.package(183)
pub let format_version: u16 = 4

pub enum Encoding as u8:
    unknown = 0
    text = 1
    binary = 2
    package = 3

pub enum DType as u8:
    boolean = 0
    character = 1
    int8 = 2
    int16 = 3
    int32 = 4
    int64 = 5
    uint8 = 6
    uint16 = 7
    uint32 = 8
    uint64 = 9
    float32 = 10
    float64 = 11
    string = 12
    float16 = 13

pub enum Interpolation as u8:
    held = 0
    linear = 1
    bezier = 2

# Each owned allocation uses memory.heap. Base copies borrow; close/release exactly
# once. Exported objects are shared through standard interop, including from Luce.
let max_bytes: usize = 268435456
let max_items: usize = 1048576
let max_depth: usize = 128


struct List[T]:
    var items: T[]
    var count: usize

    mutating func reserve(count: usize) -> !:
        if count > max_items:
            error(limit_exceeded, "Prism collection limit exceeded")
        if count <= self.items.length:
            return
        let capacity = count if count > self.items.length * 2 else self.items.length * 2
        let grown = try alloc T[capacity] in memory.heap
        memory.copy(grown, self.items, self.count)
        if self.items.length > 0:
            free(self.items) in memory.heap
        self.items = grown

    mutating func push(value: T) -> !:
        try self.reserve(self.count + 1)
        self.items[self.count] = value
        self.count += 1

    func span() -> T[]:
        return self.items[..<self.count]

    mutating func remove(index: usize):
        for i in index + 1..<self.count:
            self.items[i - 1] = self.items[i]
        self.count -= 1

    mutating func close():
        if self.items.length > 0:
            free(self.items) in memory.heap
        var empty: T[]
        self.items = empty
        self.count = 0

struct Buffer:
    var data: u8[]
    var used: usize

    mutating func reserve(count: usize) -> !:
        if count > max_bytes:
            error(limit_exceeded, "Prism byte limit exceeded (256 MiB)")
        if count <= self.data.length:
            return
        var capacity = self.data.length * 2
        if capacity < 64:
            capacity = 64
        if capacity < count:
            capacity = count
        if capacity > max_bytes:
            capacity = max_bytes
        let grown = try alloc u8[capacity] in memory.heap
        memory.copy(grown, self.data, self.used)
        if self.data.length > 0:
            free(self.data) in memory.heap
        self.data = grown

    mutating func put(data: const u8[]) -> !:
        let count = self.used +? data.length else error(limit_exceeded, "Prism byte size overflow")
        # Internal callers never append an alias of a buffer to itself.
        try self.reserve(count)
        memory.copy(self.data[self.used..], data, data.length)
        self.used = count

    mutating func text(value: str) -> !:
        try self.put(value.bytes)

    mutating func byte(value: u8) -> !:
        let data: u8[1] = [value]
        try self.put(data)

    mutating func uint(value: u64, width: usize) -> !:
        for i in 0..<width:
            try self.byte((u8)((value >> (i * 8)) & 255))

    mutating func real(value: f64) -> !:
        var finite = value if math.is_finite(value) else 0.0
        try self.uint(memory.read[u64](&finite), 8)

    mutating func sized(value: str) -> !:
        try self.uint((u64)value.length, 4)
        try self.text(value)

    func bytes() -> const u8[]:
        return self.data[..<self.used]

    func view() -> str:
        return (str)self.bytes()

    func copy() -> Buffer!:
        return try copied(self.bytes())

    mutating func close():
        if self.data.length > 0:
            free(self.data) in memory.heap
        var empty: u8[]
        self.data = empty
        self.used = 0

func copied(data: const u8[]) -> Buffer!:
    var output: Buffer
    errdefer output.close()
    try output.put(data)
    return output

func text_copy(value: str) -> Buffer!:
    return try copied(value.bytes)

func less(a: str, b: str) -> bool:
    let count = a.length if a.length < b.length else b.length
    for i in 0..<count:
        if a.bytes[i] != b.bytes[i]:
            return a.bytes[i] < b.bytes[i]
    return a.length < b.length

struct Reader:
    var data: const u8[]
    var pos: usize
    var budget: usize = max_bytes

    func remaining() -> usize:
        return self.data.length - self.pos

    mutating func take(count: usize) -> const u8[]!:
        if count > self.remaining():
            error(invalid, "truncated Prism input")
        let start = self.pos
        self.pos += count
        return self.data[start..<self.pos]

    mutating func uint(width: usize) -> u64!:
        let bytes = try self.take(width)
        var value: u64 = 0
        for i in 0..<width:
            value |= (u64)bytes[i] << (i * 8)
        return value

    mutating func count(minimum: usize) -> usize!:
        let count = (usize)try self.uint(4)
        if count > max_items or (minimum > 0 and count > self.remaining() // minimum):
            error(limit_exceeded, "implausible Prism record count")
        return count

    mutating func real() -> f64!:
        var bits = try self.uint(8)
        let value = memory.read[f64](&bits)
        if not math.is_finite(value):
            error(invalid, "non-finite Prism time or handle")
        return value

    mutating func text() -> str!:
        let size = (usize)try self.uint(4)
        let data = try self.take(size)
        return str(data) catch failure:
            error(invalid, "invalid UTF-8 in Prism string")

pub struct Blob:
    var storage: Buffer

    pub func bytes() -> const u8[]:
        return self.storage.bytes()

    pub func text() -> str!:
        return try str(self.storage.bytes())

    pub func size() -> usize:
        return self.storage.used

    pub mutating func close():
        self.storage.close()

pub let blob_type = interop.Type[Blob]("Prism bytes", Blob.close, closeable = true)

func own_blob(storage: Buffer) -> interop.Reference[Blob]!:
    var owned = storage
    let native = new Blob(storage = owned) in memory.heap catch failure:
        owned.close()
        error(failure.code, failure.message)
    return try interop.Reference[Blob].adopt(native, blob_type, memory.heap)


func name_byte(byte: u8) -> bool:
    return (byte >= 'A' and byte <= 'Z') or (byte >= 'a' and byte <= 'z') or (byte >= '0' and byte <= '9') or byte == '_'

func valid_name(name: str) -> bool:
    if name.length == 0:
        return false
    for byte in name.bytes:
        if not name_byte(byte):
            return false
    return true

func anonymous(name: str) -> bool:
    if name.length < 3 or name.bytes[0] != '[' or name.bytes[name.length - 1] != ']':
        return false
    for byte in name.bytes[1..<name.length - 1]:
        if byte < '0' or byte > '9':
            return false
    return true

## Matches kinogaki Path::parse, including positional [N] segments.
pub func valid_path(path: str) -> bool:
    if path == "/":
        return true
    if path.length < 2 or path.bytes[0] != '/' or path.length > 4096:
        return false
    var start: usize = 1
    var slot = false
    for i in 1..=path.length:
        let byte: u8 = 0 if i == path.length else path.bytes[i]
        if byte == 0 and i != path.length:
            return false
        if byte == '/' or byte == '.' or byte == 0:
            let part = (str)path.bytes[start..<i]
            if not valid_name(part) and (slot or not anonymous(part)):
                return false
            if slot and byte != 0:
                return false
            slot = byte == '.'
            start = i + 1
    return true

pub func element_path(path: str) -> str:
    for i in 0..<path.length:
        if path.bytes[i] == '.':
            return (str)path.bytes[..<i]
    return path

pub func parent_path(path: str) -> str:
    let element = element_path(path)
    var index = element.length
    while index > 1:
        index -= 1
        if element.bytes[index] == '/':
            return (str)element.bytes[..<index]
    return "/"

pub func path_name(path: str) -> str:
    let element = element_path(path)
    if element == "/":
        return ""
    let parent = parent_path(element)
    return (str)element.bytes[(1 if parent == "/" else parent.length + 1)..]

func slot_name(path: str) -> str:
    let element = element_path(path)
    return "" if element.length == path.length else (str)path.bytes[element.length + 1..]

pub func is_descendant(path: str, root: str) -> bool:
    let element = element_path(path)
    let base = element_path(root)
    if base == "/":
        return true
    return element == base or (element.length > base.length and (str)element.bytes[..<base.length] == base and element.bytes[base.length] == '/')

func require_element(path: str) -> !:
    if not valid_path(path) or path == "/" or element_path(path) != path:
        error(invalid, "expected a non-root Prism element path")

func require_slot(path: str) -> !:
    if not valid_path(path) or slot_name(path) == "":
        error(invalid, "expected a Prism property path")

func joined(parent: str, name: str, separator: str = "/") -> Buffer!:
    var out: Buffer
    errdefer out.close()
    if parent != "/" or separator != "/":
        try out.text(parent)
    try out.text(separator)
    try out.text(name)
    return out


func dtype_width(dtype: DType) -> usize:
    if dtype == DType.string:
        return 0
    if dtype == DType.int16 or dtype == DType.uint16 or dtype == DType.float16:
        return 2
    if dtype == DType.int32 or dtype == DType.uint32 or dtype == DType.float32:
        return 4
    if dtype == DType.int64 or dtype == DType.uint64 or dtype == DType.float64:
        return 8
    return 1

func dtype_from(code: u64) -> DType!:
    let types: DType[14] = [DType.boolean, DType.character, DType.int8, DType.int16, DType.int32, DType.int64, DType.uint8, DType.uint16, DType.uint32, DType.uint64, DType.float32, DType.float64, DType.string, DType.float16]
    if code >= 14:
        error(invalid, "unknown Prism dtype")
    return types[(usize)code]

func floating(dtype: DType) -> bool:
    return dtype == DType.float16 or dtype == DType.float32 or dtype == DType.float64

func shape_count(shape: const u32[]) -> usize!:
    if shape.length > 16:
        error(limit_exceeded, "Prism values support at most 16 dimensions")
    var count: usize = 1
    for dimension in shape:
        count = count *? (usize)dimension else error(limit_exceeded, "Prism shape overflow")
    if count > max_bytes:
        error(limit_exceeded, "Prism value element limit exceeded")
    return count

struct ValueData:
    var kind: DType = DType.boolean
    var shape: List[u32]
    var payload: Buffer

    func count() -> usize:
        var result: usize = 1
        for dimension in self.shape.span():
            result *= (usize)dimension
        return result

    func copy() -> ValueData!:
        var out = try value_header(self.kind, self.shape.span())
        errdefer out.close()
        out.payload = try self.payload.copy()
        return out

    func bits(index: usize) -> u64:
        let width = dtype_width(self.kind)
        var bits: u64 = 0
        for i in 0..<width:
            bits |= (u64)self.payload.data[index * width + i] << (i * 8)
        return bits

    func number(index: usize) -> f64!:
        if index >= self.count() or self.kind == DType.string:
            error(invalid, "expected a numeric Prism component")
        var bits = self.bits(index)
        if self.kind == DType.float64:
            return memory.read[f64](&bits)
        if self.kind == DType.float32:
            var narrow = (u32)bits
            return (f64)memory.read[f32](&narrow)
        if self.kind == DType.float16:
            return half_number((u16)bits)
        if self.kind == DType.int8 or self.kind == DType.int16 or self.kind == DType.int32 or self.kind == DType.int64:
            return (f64)self.signed(index)
        return (f64)bits

    func signed(index: usize) -> i64:
        let width = dtype_width(self.kind)
        var bits = self.bits(index)
        if width < 8 and (bits & ((u64)1 << (width * 8 - 1))) != 0:
            bits |= 18446744073709551615 << (width * 8)
        return memory.read[i64](&bits)

    mutating func close():
        self.shape.close()
        self.payload.close()

func value_header(dtype: DType, shape: const u32[]) -> ValueData!:
    discard(try shape_count(shape))
    var out = ValueData(kind = dtype)
    errdefer out.close()
    for dimension in shape:
        try out.shape.push(dimension)
    return out

func read_value(reader: Reader*) -> ValueData!:
    let dtype = try dtype_from(try reader.uint(1))
    let rank = (usize)try reader.uint(1)
    if rank > 16:
        error(limit_exceeded, "Prism rank exceeds 16")
    var shape: u32[16]
    for i in 0..<rank:
        shape[i] = (u32)try reader.uint(4)
    var out = try value_header(dtype, shape[..<rank])
    errdefer out.close()
    let count = out.count()
    if dtype == DType.string:
        if count > reader.remaining() // 4:
            error(invalid, "truncated Prism string array")
        for i in 0..<count:
            try out.payload.sized(try reader.text())
    else:
        let size = count *? dtype_width(dtype) else error(limit_exceeded, "Prism payload overflow")
        out.payload = try copied(try reader.take(size))
    return out

func write_value(out: Buffer*, value: const ValueData*) -> !:
    try out.uint((u64)value.kind, 1)
    try out.uint((u64)value.shape.count, 1)
    for dimension in value.shape.span():
        try out.uint((u64)dimension, 4)
    # Preserve half bit patterns, as the C++ writer does. Other non-finite
    # floating payloads normalize to zero in both legacy encodings.
    if value.kind == DType.float32 or value.kind == DType.float64:
        for i in 0..<value.count():
            let finite = math.is_finite(try value.number(i))
            try out.uint(value.bits(i) if finite else 0, dtype_width(value.kind))
    else:
        try out.put(value.payload.bytes())

func scalar_bits(dtype: DType, bits: u64) -> ValueData!:
    var out = ValueData(kind = dtype)
    errdefer out.close()
    try out.payload.uint(bits, dtype_width(dtype))
    return out

func half_number(bits: u16) -> f64:
    let sign = -1.0 if (bits & 32768) != 0 else 1.0
    let exponent = (bits >> 10) & 31
    let mantissa = bits & 1023
    if exponent == 31:
        var raw: u64 = 9218868437227405312 if mantissa == 0 else 9221120237041090560
        return sign * memory.read[f64](&raw)
    var value = (f64)mantissa / 1024.0 if exponent == 0 else 1.0 + (f64)mantissa / 1024.0
    var power = -14 if exponent == 0 else (i32)exponent - 15
    while power < 0:
        value *= 0.5
        power += 1
    while power > 0:
        value *= 2.0
        power -= 1
    return sign * value

func half_bits(number: f64) -> u16:
    var value = (f32)number
    let bits = memory.read[u32](&value)
    let sign = (bits >> 16) & 32768
    var mantissa = bits & 8388607
    let exponent = (i32)((bits >> 23) & 255) - 112
    if ((bits >> 23) & 255) == 255:
        return (u16)(sign | 31744 | (512 if mantissa != 0 else 0))
    if exponent >= 31:
        return (u16)(sign | 31744)
    if exponent <= 0:
        if exponent < -10:
            return (u16)sign
        mantissa |= 8388608
        let shift = (u32)(14 - exponent)
        var rounded = mantissa >> shift
        if ((mantissa >> (shift - 1)) & 1) != 0:
            rounded += 1
        return (u16)(sign | rounded)
    var result = sign | ((u32)exponent << 10) | (mantissa >> 13)
    if (mantissa & 4096) != 0:
        result += 1
    return (u16)result

func append_number(payload: Buffer*, kind: DType, value: f64) -> !:
    if kind == DType.float64:
        var number = value
        try payload.uint(memory.read[u64](&number), 8)
    elif kind == DType.float32:
        var number = (f32)value
        try payload.uint((u64)memory.read[u32](&number), 4)
    else:
        try payload.uint((u64)half_bits(value), 2)

pub struct Value:
    var data: ValueData = ValueData()

    pub func init(number: f64 = 0.0) -> !:
        var value = number
        self.data = try scalar_bits(DType.float64, memory.read[u64](&value))

    pub static func integer(value: i64) -> interop.Reference[Value]!:
        var signed_value = value
        return try own_value(try scalar_bits(DType.int64, memory.read[u64](&signed_value)))

    pub static func unsigned(value: u64) -> interop.Reference[Value]!:
        return try own_value(try scalar_bits(DType.uint64, value))

    pub static func number(value: f64) -> interop.Reference[Value]!:
        var number = value
        return try own_value(try scalar_bits(DType.float64, memory.read[u64](&number)))

    pub static func boolean(value: bool) -> interop.Reference[Value]!:
        return try own_value(try scalar_bits(DType.boolean, 1 if value else 0))

    pub static func text(value: str) -> interop.Reference[Value]!:
        var data = ValueData(kind = DType.string)
        data.payload.sized(value) catch failure:
            data.close()
            error(failure.code, failure.message)
        return try own_value(data)

    ## Numeric payload bytes are little-endian, shape is row-major. Input is copied.
    pub static func array(dtype: DType, shape: const i64[], bytes: const u8[]) -> interop.Reference[Value]!:
        var scratch: u32[16]
        let dimensions = try checked_shape(shape, scratch)
        if dtype == DType.string:
            error(invalid, "use Value.strings for string arrays")
        let count = try shape_count(dimensions)
        if count > max_bytes // dtype_width(dtype) or bytes.length != count * dtype_width(dtype):
            error(invalid, "Prism array payload does not match its shape and dtype")
        var data = try value_header(dtype, dimensions)
        data.payload = copied(bytes) catch failure:
            data.close()
            error(failure.code, failure.message)
        return try own_value(data)

    pub static func strings(shape: const i64[], values: const str[]) -> interop.Reference[Value]!:
        var scratch: u32[16]
        let dimensions = try checked_shape(shape, scratch)
        if try shape_count(dimensions) != values.length:
            error(invalid, "Prism string count does not match its shape")
        var data = try value_header(DType.string, dimensions)
        for value in values:
            data.payload.sized(value) catch failure:
                data.close()
                error(failure.code, failure.message)
        return try own_value(data)

    pub static func numbers(shape: const i64[], values: const f64[], dtype: DType = DType.float64) -> interop.Reference[Value]!:
        var scratch: u32[16]
        let dimensions = try checked_shape(shape, scratch)
        if not floating(dtype) or try shape_count(dimensions) != values.length:
            error(invalid, "expected a floating dtype and matching Prism shape")
        var data = try value_header(dtype, dimensions)
        for value in values:
            append_number(&data.payload, dtype, value) catch failure:
                data.close()
                error(failure.code, failure.message)
        return try own_value(data)

    pub func dtype() -> DType:
        return self.data.kind

    pub func rank() -> usize:
        return self.data.shape.count

    pub func dimension(index: usize) -> usize!:
        if index >= self.data.shape.count:
            error(invalid, "Prism dimension index is out of bounds")
        return self.data.shape.items[index]

    pub func count() -> usize:
        return self.data.count()

    pub func bytes() -> const u8[]:
        return self.data.payload.bytes()

    pub func number_at(index: usize = 0) -> f64!:
        return try self.data.number(index)

    pub func integer_at(index: usize = 0) -> i64!:
        let kind = self.data.kind
        if index >= self.count() or (kind != DType.int8 and kind != DType.int16 and kind != DType.int32 and kind != DType.int64):
            error(invalid, "expected a signed integer Prism component")
        return self.data.signed(index)

    pub func unsigned_at(index: usize = 0) -> u64!:
        if index >= self.count() or floating(self.data.kind) or self.data.kind == DType.string:
            error(invalid, "expected an integer Prism component")
        return self.data.bits(index)

    pub func text_at(index: usize = 0) -> str!:
        if self.data.kind != DType.string or index >= self.count():
            error(invalid, "expected a Prism string component")
        var reader = Reader(data = self.data.payload.bytes())
        for i in 0..<index:
            discard(try reader.text())
        return try reader.text()

    pub mutating func close():
        self.data.close()

pub let value_type = interop.Type[Value]("Prism value", Value.close, closeable = true)

func own_value(data: ValueData) -> interop.Reference[Value]!:
    var owned = data
    let native = new Value() in memory.heap catch failure:
        owned.close()
        error(failure.code, failure.message)
    native.data.close()
    native.data = owned
    return try interop.Reference[Value].adopt(native, value_type, memory.heap)


func checked_shape(shape: const i64[], output: u32[]) -> const u32[]!:
    if shape.length > 16:
        error(limit_exceeded, "Prism values support at most 16 dimensions")
    for i in 0..<shape.length:
        if shape[i] < 0 or shape[i] > 4294967295:
            error(invalid, "Prism dimensions must fit uint32")
        output[i] = (u32)shape[i]
    return output[..<shape.length]


struct Sample:
    var time: f64
    var value: ValueData = ValueData()
    var interpolation: Interpolation = Interpolation.linear
    var handle: u8
    var left: List[f64]
    var right: List[f64]

    mutating func close():
        self.value.close()
        self.left.close()
        self.right.close()

struct Property:
    var name: Buffer
    var value: ValueData = ValueData()
    var type_name: Buffer
    var samples: List[Sample]

    mutating func close():
        self.name.close()
        self.value.close()
        self.type_name.close()
        for i in 0..<self.samples.count:
            self.samples.items[i].close()
        self.samples.close()

struct Pair:
    var key: Buffer
    var value: Buffer

    mutating func close():
        self.key.close()
        self.value.close()

func pair(key: str, value: str) -> Pair!:
    var out: Pair
    errdefer out.close()
    out.key = try text_copy(key)
    out.value = try text_copy(value)
    return out

func close_names(names: List[Buffer]*):
    for i in 0..<names.count:
        names.items[i].close()
    names.close()

func add_name(names: List[Buffer]*, name: str) -> !:
    for item in names.span():
        if item.view() == name:
            return
    var copy = try text_copy(name)
    errdefer copy.close()
    try names.push(copy)
    var index = names.count - 1
    while index > 0 and less(names.items[index].view(), names.items[index - 1].view()):
        let previous = names.items[index - 1]
        names.items[index - 1] = names.items[index]
        names.items[index] = previous
        index -= 1

struct Element:
    var path: Buffer
    var kind: Buffer
    var properties: List[Property]
    var metadata: List[Pair]
    var override: bool
    var removed_properties: List[Buffer]
    var removed_metadata: List[Buffer]

    func property(name: str) -> usize?:
        for i in 0..<self.properties.count:
            if self.properties.items[i].name.view() == name:
                return i
        return none

    mutating func close():
        self.path.close()
        self.kind.close()
        for i in 0..<self.properties.count:
            self.properties.items[i].close()
        self.properties.close()
        for i in 0..<self.metadata.count:
            self.metadata.items[i].close()
        self.metadata.close()
        close_names(&self.removed_properties)
        close_names(&self.removed_metadata)

struct Reorder:
    var parent: Buffer
    var children: List[Buffer]

    mutating func close():
        self.parent.close()
        close_names(&self.children)

struct Asset:
    var path: Buffer
    var mime: Buffer
    var bytes: Buffer

    mutating func close():
        self.path.close()
        self.mime.close()
        self.bytes.close()

pub struct Document:
    var elements: List[Element]
    # Connection key is target, value is source, sorted by target.
    var connections: List[Pair]
    var deletions: List[Buffer]
    var disconnections: List[Buffer]
    var reorders: List[Reorder]
    # Wildcard key is source, value is target specification.
    var globs: List[Pair]
    var assets: List[Asset]

    pub func init():
        return

    func find(path: str) -> usize?:
        for i in 0..<self.elements.count:
            if self.elements.items[i].path.view() == path:
                return i
        return none

    func require(path: str) -> usize!:
        return self.find(path) else error(missing, "Prism element does not exist")

    pub func contains(path: str) -> bool:
        return self.find(path) != none

    pub func element_count() -> usize:
        return self.elements.count

    pub func path_at(index: usize) -> str!:
        if index >= self.elements.count:
            error(invalid, "Prism element index is out of bounds")
        return self.elements.items[index].path.view()

    pub func type_at(path: str) -> str!:
        return self.elements.items[try self.require(path)].kind.view()

    pub mutating func add(path: str, type_name: str, override: bool = false) -> !:
        try require_element(path)
        if self.contains(path):
            error(invalid, "duplicate Prism element path")
        let parent = parent_path(path)
        if parent != "/" and not self.contains(parent):
            error(missing, "add the Prism parent before its child")
        try self.insert(path, type_name, override)

    mutating func insert(path: str, type_name: str, override: bool = false) -> !:
        try require_element(path)
        if self.contains(path):
            error(invalid, "duplicate Prism element path")
        var element: Element
        errdefer element.close()
        element.path = try text_copy(path)
        element.kind = try text_copy(type_name)
        element.override = override
        try self.elements.push(element)

    mutating func put_value(path: str, name: str, value: ValueData, type_name: str = "") -> !:
        var owned = value
        errdefer owned.close()
        let index = try self.require(path)
        var label = try text_copy(type_name)
        errdefer label.close()
        let element = &self.elements.items[index]
        if let position = element.property(name):
            let prop = &element.properties.items[position]
            prop.value.close()
            prop.type_name.close()
            prop.value = owned
            prop.type_name = label
            return
        var key = try text_copy(name)
        errdefer key.close()
        try element.properties.push(Property(name = key, value = owned, type_name = label))
        var position = element.properties.count - 1
        while position > 0 and less(element.properties.items[position].name.view(), element.properties.items[position - 1].name.view()):
            let previous = element.properties.items[position - 1]
            element.properties.items[position - 1] = element.properties.items[position]
            element.properties.items[position] = previous
            position -= 1

    ## Insert a deep snapshot. Later edits or closing Value never change the document.
    pub mutating func set(path: str, name: str, value: interop.Reference[Value], type_name: str = "") -> !:
        let native = try value.get()
        try self.put_value(path, name, try native.data.copy(), type_name)

    pub func get(path: str, name: str) -> interop.Reference[Value]!:
        let element = &self.elements.items[try self.require(path)]
        let index = element.property(name) else error(missing, "Prism property does not exist")
        return try own_value(try element.properties.items[index].value.copy())

    pub func property_count(path: str) -> usize!:
        return self.elements.items[try self.require(path)].properties.count

    pub func property_name(path: str, index: usize) -> str!:
        let element = &self.elements.items[try self.require(path)]
        if index >= element.properties.count:
            error(invalid, "Prism property index is out of bounds")
        return element.properties.items[index].name.view()

    pub mutating func set_metadata(path: str, key: str, value: str) -> !:
        let element = &self.elements.items[try self.require(path)]
        try set_pair(&element.metadata, key, value)

    pub func metadata(path: str, key: str) -> str!:
        let element = &self.elements.items[try self.require(path)]
        for item in element.metadata.span():
            if item.key.view() == key:
                return item.value.view()
        error(missing, "Prism metadata does not exist")

    pub mutating func connect(source: str, target: str) -> !:
        try require_slot(source)
        try require_slot(target)
        discard(try self.require(element_path(source)))
        discard(try self.require(element_path(target)))
        try set_pair(&self.connections, target, source)

    pub func connection_count() -> usize:
        return self.connections.count

    pub func source(target: str) -> str!:
        for connection in self.connections.span():
            if connection.key.view() == target:
                return connection.value.view()
        error(missing, "Prism input is not connected")

    pub mutating func disconnect(target: str):
        for i in 0..<self.connections.count:
            if self.connections.items[i].key.view() == target:
                self.connections.items[i].close()
                self.connections.remove(i)
                return

    pub mutating func set_sample(path: str, name: str, time: f64, value: interop.Reference[Value], interpolation: Interpolation = Interpolation.linear) -> !:
        if not math.is_finite(time):
            error(invalid, "Prism keyframe time must be finite")
        let element = &self.elements.items[try self.require(path)]
        let index = element.property(name) else error(missing, "create a default before adding Prism samples")
        let prop = &element.properties.items[index]
        var sample = Sample(time = time, interpolation = interpolation)
        errdefer sample.close()
        sample.value = try (try value.get()).data.copy()
        try insert_sample(prop, sample)

    pub func sample_count(path: str, name: str) -> usize!:
        let element = &self.elements.items[try self.require(path)]
        let index = element.property(name) else error(missing, "Prism property does not exist")
        return element.properties.items[index].samples.count

    pub func resolve(path: str, name: str, time: f64 = 0.0) -> interop.Reference[Value]!:
        if not math.is_finite(time):
            error(invalid, "Prism evaluation time must be finite")
        let element = &self.elements.items[try self.require(path)]
        let index = element.property(name) else error(missing, "Prism property does not exist")
        return try own_value(try resolve_property(&element.properties.items[index], time))

    ## Resolve connection chains, reporting cycles instead of silently guessing.
    pub func eval(slot: str, time: f64 = 0.0) -> interop.Reference[Value]!:
        try require_slot(slot)
        var current = slot
        for step in 0..=self.connections.count:
            var next: str? = none
            for connection in self.connections.span():
                if connection.key.view() == current:
                    next = connection.value.view()
                    break
            if let target = next:
                current = target
            else:
                return try self.resolve(element_path(current), slot_name(current), time)
        error(invalid, "cycle in Prism connections")

    pub mutating func mark_deleted(path: str) -> !:
        try require_element(path)
        try add_name(&self.deletions, path)

    pub mutating func mark_disconnected(target: str) -> !:
        try require_slot(target)
        try add_name(&self.disconnections, target)

    pub mutating func mark_unset(path: str, name: str, metadata: bool = false) -> !:
        let element = &self.elements.items[try self.require(path)]
        if metadata:
            try add_name(&element.removed_metadata, name)
        else:
            try add_name(&element.removed_properties, name)

    pub mutating func reorder(parent: str, children: const str[]) -> !:
        if not valid_path(parent) or element_path(parent) != parent:
            error(invalid, "invalid Prism reorder parent")
        var order: Reorder
        errdefer order.close()
        order.parent = try text_copy(parent)
        for child in children:
            try require_element(child)
            if parent_path(child) != parent:
                error(invalid, "Prism reorder entries must be direct children")
            for existing in order.children.span():
                if existing.view() == child:
                    error(invalid, "duplicate Prism reorder child")
            var copy = try text_copy(child)
            order.children.push(copy) catch failure:
                copy.close()
                error(failure.code, failure.message)
        for i in 0..<self.reorders.count:
            if self.reorders.items[i].parent.view() == parent:
                self.reorders.items[i].close()
                self.reorders.items[i] = order
                return
        try self.reorders.push(order)
        sort_reorders(&self.reorders)

    pub mutating func connect_pattern(source: str, target_pattern: str) -> !:
        try require_slot(source)
        if target_pattern.length == 0 or target_pattern.bytes[0] != '/':
            error(invalid, "Prism wildcard target must be absolute")
        for item in self.globs.span():
            if item.key.view() == source and item.value.view() == target_pattern:
                return
        var item = try pair(source, target_pattern)
        errdefer item.close()
        try self.globs.push(item)
        sort_pairs(&self.globs)

    pub mutating func set_asset(path: str, bytes: const u8[], mime: str = "application/octet-stream") -> !:
        try require_element(path)
        var asset: Asset
        errdefer asset.close()
        asset.path = try text_copy(path)
        asset.mime = try text_copy(mime)
        asset.bytes = try copied(bytes)
        for i in 0..<self.assets.count:
            if self.assets.items[i].path.view() == path:
                self.assets.items[i].close()
                self.assets.items[i] = asset
                return
        try self.assets.push(asset)
        var i = self.assets.count - 1
        while i > 0 and less(self.assets.items[i].path.view(), self.assets.items[i - 1].path.view()):
            let previous = self.assets.items[i - 1]
            self.assets.items[i - 1] = self.assets.items[i]
            self.assets.items[i] = previous
            i -= 1

    ## Rename/reparent a subtree. All allocations finish before any path changes.
    pub mutating func rename(path: str, destination: str) -> !:
        try require_element(path)
        try require_element(destination)
        discard(try self.require(path))
        if path == destination:
            return
        if is_descendant(destination, path) or self.contains(destination):
            error(invalid, "Prism rename would collide or create a hierarchy cycle")
        let parent = parent_path(destination)
        if parent != "/":
            discard(try self.require(parent))
        # Asset and layer paths may exist without local elements. Do not merge
        # those records accidentally when moving a populated subtree onto them.
        for asset in self.assets.span():
            if is_descendant(asset.path.view(), destination) and not is_descendant(asset.path.view(), path):
                error(invalid, "Prism rename collides with an asset path")
        for connection in self.connections.span():
            if is_descendant(connection.key.view(), destination) and not is_descendant(connection.key.view(), path):
                error(invalid, "Prism rename collides with a connection target")
        for order in self.reorders.span():
            if is_descendant(order.parent.view(), destination) and not is_descendant(order.parent.view(), path):
                error(invalid, "Prism rename collides with a reorder opinion")
        for deletion in self.deletions.span():
            if is_descendant(deletion.view(), destination) and not is_descendant(deletion.view(), path):
                error(invalid, "Prism rename collides with a deletion opinion")
        for deletion in self.disconnections.span():
            if is_descendant(deletion.view(), destination) and not is_descendant(deletion.view(), path):
                error(invalid, "Prism rename collides with a disconnect opinion")
        var edits: List[PathEdit]
        defer close_edits(&edits)
        for i in 0..<self.elements.count:
            try plan_path(&edits, &self.elements.items[i].path, path, destination)
        for i in 0..<self.connections.count:
            try plan_path(&edits, &self.connections.items[i].key, path, destination)
            try plan_path(&edits, &self.connections.items[i].value, path, destination)
        for i in 0..<self.assets.count:
            try plan_path(&edits, &self.assets.items[i].path, path, destination)
        for i in 0..<self.globs.count:
            try plan_path(&edits, &self.globs.items[i].key, path, destination)
            try plan_path(&edits, &self.globs.items[i].value, path, destination)
        for i in 0..<self.reorders.count:
            try plan_path(&edits, &self.reorders.items[i].parent, path, destination)
            for j in 0..<self.reorders.items[i].children.count:
                try plan_path(&edits, &self.reorders.items[i].children.items[j], path, destination)
        for i in 0..<self.deletions.count:
            try plan_path(&edits, &self.deletions.items[i], path, destination)
        for i in 0..<self.disconnections.count:
            try plan_path(&edits, &self.disconnections.items[i], path, destination)
        for i in 0..<edits.count:
            let edit = &edits.items[i]
            edit.target.close()
            *edit.target = edit.replacement
            edit.replacement = Buffer()
        sort_pairs(&self.connections)
        sort_pairs(&self.globs)
        sort_names(&self.deletions)
        sort_names(&self.disconnections)
        sort_assets(&self.assets)
        sort_reorders(&self.reorders)
        # A moved child is no longer part of the old parent's reorder opinion.
        for i in 0..<self.reorders.count:
            let order = &self.reorders.items[i]
            var j = order.children.count
            while j > 0:
                j -= 1
                if parent_path(order.children.items[j].view()) != order.parent.view():
                    order.children.items[j].close()
                    order.children.remove(j)

    ## Remove content, incident wires, assets and affected wildcard/reorder entries.
    pub mutating func remove(path: str) -> !:
        try require_element(path)
        discard(try self.require(path))
        var owned_path = try text_copy(path)
        defer owned_path.close()
        let root = owned_path.view()
        var i = self.elements.count
        while i > 0:
            i -= 1
            if is_descendant(self.elements.items[i].path.view(), root):
                self.elements.items[i].close()
                self.elements.remove(i)
        i = self.connections.count
        while i > 0:
            i -= 1
            if is_descendant(self.connections.items[i].key.view(), root) or is_descendant(self.connections.items[i].value.view(), root):
                self.connections.items[i].close()
                self.connections.remove(i)
        i = self.assets.count
        while i > 0:
            i -= 1
            if is_descendant(self.assets.items[i].path.view(), root):
                self.assets.items[i].close()
                self.assets.remove(i)
        i = self.globs.count
        while i > 0:
            i -= 1
            if is_descendant(self.globs.items[i].key.view(), root) or is_descendant(self.globs.items[i].value.view(), root):
                self.globs.items[i].close()
                self.globs.remove(i)
        i = self.reorders.count
        while i > 0:
            i -= 1
            let order = &self.reorders.items[i]
            if is_descendant(order.parent.view(), root):
                order.close()
                self.reorders.remove(i)
            else:
                var j = order.children.count
                while j > 0:
                    j -= 1
                    if is_descendant(order.children.items[j].view(), root):
                        order.children.items[j].close()
                        order.children.remove(j)

    pub func asset_count() -> usize:
        return self.assets.count

    pub func asset(path: str) -> interop.Reference[Blob]!:
        for asset in self.assets.span():
            if asset.path.view() == path:
                return try own_blob(try asset.bytes.copy())
        error(missing, "Prism asset does not exist")

    pub func asset_mime(path: str) -> str!:
        for asset in self.assets.span():
            if asset.path.view() == path:
                return asset.mime.view()
        error(missing, "Prism asset does not exist")

    pub func encode(encoding: Encoding = Encoding.binary, compressed: bool = false) -> interop.Reference[Blob]!:
        if encoding == Encoding.package:
            return try own_blob(try write_package(&self, compressed))
        if self.assets.count > 0:
            error(invalid, "use package encoding to preserve Prism assets")
        if encoding == Encoding.text:
            return try own_blob(try write_text(&self))
        if encoding == Encoding.binary:
            return try own_blob(try write_binary(&self, compressed))
        error(invalid, "choose a Prism encoding")

    pub static func decode(bytes: const u8[]) -> interop.Reference[Document]!:
        let native = try new Document() in memory.heap
        read_document(bytes, native) catch failure:
            native.close()
            free(native) in memory.heap
            error(failure.code, failure.message)
        return try interop.Reference[Document].adopt(native, document_type, memory.heap)

    pub static func parse(text: str) -> interop.Reference[Document]!:
        return try Document.decode(text.bytes)

    pub static func load(path: str) -> interop.Reference[Document]!:
        with memory.heap:
            let name = try strings.copy(path)
            defer strings.release(name)
            let bytes = try files.read_limit((c.str)name, max_bytes)
            defer free(bytes) in memory.heap
            return try Document.decode(bytes)

    pub func save(path: str, encoding: Encoding = Encoding.binary, compressed: bool = false) -> !:
        let output = try self.encode(encoding, compressed)
        defer output.release()
        with memory.heap:
            let name = try strings.copy(path)
            defer strings.release(name)
            try files.write((c.str)name, output.value().bytes())

    pub mutating func close():
        for i in 0..<self.elements.count:
            self.elements.items[i].close()
        self.elements.close()
        for i in 0..<self.connections.count:
            self.connections.items[i].close()
        self.connections.close()
        close_names(&self.deletions)
        close_names(&self.disconnections)
        for i in 0..<self.reorders.count:
            self.reorders.items[i].close()
        self.reorders.close()
        for i in 0..<self.globs.count:
            self.globs.items[i].close()
        self.globs.close()
        for i in 0..<self.assets.count:
            self.assets.items[i].close()
        self.assets.close()

pub let document_type = interop.Type[Document]("Prism document", Document.close, closeable = true)

func sort_pairs(pairs: List[Pair]*):
    for end in 1..<pairs.count:
        var i = end
        while i > 0:
            let a = &pairs.items[i]
            let b = &pairs.items[i - 1]
            if not less(a.key.view(), b.key.view()) and (a.key.view() != b.key.view() or not less(a.value.view(), b.value.view())):
                break
            let previous = pairs.items[i - 1]
            pairs.items[i - 1] = pairs.items[i]
            pairs.items[i] = previous
            i -= 1

func set_pair(pairs: List[Pair]*, key: str, value: str) -> !:
    var replacement = try pair(key, value)
    errdefer replacement.close()
    for i in 0..<pairs.count:
        if pairs.items[i].key.view() == key:
            pairs.items[i].close()
            pairs.items[i] = replacement
            return
    try pairs.push(replacement)
    sort_pairs(pairs)

func insert_sample(prop: Property*, sample: Sample) -> !:
    for i in 0..<prop.samples.count:
        if prop.samples.items[i].time == sample.time:
            prop.samples.items[i].close()
            prop.samples.items[i] = sample
            return
    try prop.samples.push(sample)
    var i = prop.samples.count - 1
    while i > 0 and prop.samples.items[i].time < prop.samples.items[i - 1].time:
        let previous = prop.samples.items[i - 1]
        prop.samples.items[i - 1] = prop.samples.items[i]
        prop.samples.items[i] = previous
        i -= 1

func same_shape(a: const ValueData*, b: const ValueData*) -> bool:
    if a.kind != b.kind or a.shape.count != b.shape.count:
        return false
    for i in 0..<a.shape.count:
        if a.shape.items[i] != b.shape.items[i]:
            return false
    return true

func resolve_property(prop: const Property*, time: f64) -> ValueData!:
    if prop.samples.count == 0:
        return try prop.value.copy()
    let samples = prop.samples.span()
    if time <= samples[0].time:
        return try samples[0].value.copy()
    for i in 1..<samples.length:
        if time == samples[i].time:
            return try samples[i].value.copy()
        if time < samples[i].time:
            let a = &samples[i - 1]
            let b = &samples[i]
            if a.interpolation == Interpolation.bezier:
                error(unsupported, "Bezier data is preserved; Bezier evaluation is not implemented")
            if a.interpolation == Interpolation.held or not floating(a.value.kind) or not same_shape(&a.value, &b.value):
                return try a.value.copy()
            var output = try value_header(a.value.kind, a.value.shape.span())
            errdefer output.close()
            let ratio = (time - a.time) / (b.time - a.time)
            for component in 0..<a.value.count():
                let left = try a.value.number(component)
                let right = try b.value.number(component)
                try append_number(&output.payload, output.kind, left * (1.0 - ratio) + right * ratio)
            return output
    return try samples[samples.length - 1].value.copy()


struct PathEdit:
    var target: Buffer*
    var replacement: Buffer

func close_edits(edits: List[PathEdit]*):
    for i in 0..<edits.count:
        edits.items[i].replacement.close()
    edits.close()

func plan_path(edits: List[PathEdit]*, target: Buffer*, old: str, replacement: str) -> !:
    if not is_descendant(target.view(), old):
        return
    var text: Buffer
    errdefer text.close()
    try text.text(replacement)
    try text.put(target.bytes()[old.length..])
    if text.used > 4096:
        error(limit_exceeded, "renamed Prism path exceeds 4096 bytes")
    try edits.push(PathEdit(target = target, replacement = text))

func sort_names(names: List[Buffer]*):
    for end in 1..<names.count:
        var i = end
        while i > 0 and less(names.items[i].view(), names.items[i - 1].view()):
            let previous = names.items[i - 1]
            names.items[i - 1] = names.items[i]
            names.items[i] = previous
            i -= 1

func sort_assets(assets: List[Asset]*):
    for end in 1..<assets.count:
        var i = end
        while i > 0 and less(assets.items[i].path.view(), assets.items[i - 1].path.view()):
            let previous = assets.items[i - 1]
            assets.items[i - 1] = assets.items[i]
            assets.items[i] = previous
            i -= 1

func sort_reorders(orders: List[Reorder]*):
    for end in 1..<orders.count:
        var i = end
        while i > 0 and less(orders.items[i].parent.view(), orders.items[i - 1].parent.view()):
            let previous = orders.items[i - 1]
            orders.items[i - 1] = orders.items[i]
            orders.items[i] = previous
            i -= 1


func byte_prefix(bytes: const u8[], prefix: const u8[]) -> bool:
    if bytes.length < prefix.length:
        return false
    for i in 0..<prefix.length:
        if bytes[i] != prefix[i]:
            return false
    return true

pub func detect(bytes: const u8[]) -> Encoding:
    if byte_prefix(bytes, b"PRSMC\0"):
        return Encoding.binary
    if byte_prefix(bytes, b"PRSMZ\0"):
        return Encoding.package
    var i: usize = 0
    while i < bytes.length and (bytes[i] == ' ' or bytes[i] == '\t' or bytes[i] == '\n' or bytes[i] == '\r'):
        i += 1
    if byte_prefix(bytes[i..], b"#prisma"):
        return Encoding.text
    return Encoding.unknown

func read_document(bytes: const u8[], document: Document*) -> !:
    if bytes.length > max_bytes:
        error(limit_exceeded, "Prism input exceeds 256 MiB")
    let encoding = detect(bytes)
    if encoding == Encoding.binary:
        try read_binary(bytes, document)
    elif encoding == Encoding.text:
        try read_text(bytes, document)
    elif encoding == Encoding.package:
        try read_package(bytes, document)
    else:
        error(invalid, "unrecognized Prism magic")

func intern(table: List[str]*, text: str) -> usize!:
    for i in 0..<table.count:
        if table.items[i] == text:
            return i
    try table.push(text)
    return table.count - 1

func string_index(table: const List[str]*, text: str) -> usize:
    for i in 0..<table.count:
        if table.items[i] == text:
            return i
    trap("Prism writer missed an interned string")

func write_index(out: Buffer*, table: const List[str]*, text: str) -> !:
    try out.uint((u64)string_index(table, text), 4)

func read_index(reader: Reader*, table: const List[str]*) -> str!:
    let index = (usize)try reader.uint(4)
    if index >= table.count:
        error(invalid, "invalid Prism string-table index")
    let text = table.items[index]
    if text.length > reader.budget:
        error(limit_exceeded, "Prism expanded string budget exceeded")
    reader.budget -= text.length
    return text

func intern_names(table: List[str]*, names: const List[Buffer]*) -> !:
    for name in names.span():
        discard(try intern(table, name.view()))

func write_names(out: Buffer*, table: const List[str]*, names: const List[Buffer]*) -> !:
    try out.uint((u64)names.count, 4)
    for name in names.span():
        try write_index(out, table, name.view())

func read_names(reader: Reader*, table: const List[str]*, names: List[Buffer]*) -> !:
    let count = try reader.count(4)
    for i in 0..<count:
        let name = try read_index(reader, table)
        let before = names.count
        try add_name(names, name)
        if names.count == before:
            error(invalid, "duplicate Prism tombstone")

func write_binary(document: const Document*, compressed: bool = false) -> Buffer!:
    var table: List[str]
    defer table.close()
    for element in document.elements.span():
        discard(try intern(&table, element.path.view()))
        discard(try intern(&table, element.kind.view()))
        for prop in element.properties.span():
            discard(try intern(&table, prop.name.view()))
        for meta in element.metadata.span():
            discard(try intern(&table, meta.key.view()))
            discard(try intern(&table, meta.value.view()))
        try intern_names(&table, &element.removed_properties)
        try intern_names(&table, &element.removed_metadata)
    for connection in document.connections.span():
        discard(try intern(&table, connection.value.view()))
        discard(try intern(&table, connection.key.view()))
    try intern_names(&table, &document.deletions)
    try intern_names(&table, &document.disconnections)
    for order in document.reorders.span():
        discard(try intern(&table, order.parent.view()))
        try intern_names(&table, &order.children)
    for glob in document.globs.span():
        discard(try intern(&table, glob.key.view()))
        discard(try intern(&table, glob.value.view()))
    var body: Buffer
    defer body.close()
    try body.uint((u64)table.count, 4)
    for text in table.span():
        try body.sized(text)
    try body.uint((u64)document.elements.count, 4)
    for element in document.elements.span():
        try write_index(&body, &table, element.path.view())
        try write_index(&body, &table, element.kind.view())
        try body.uint((u64)element.properties.count, 4)
        for prop in element.properties.span():
            try write_index(&body, &table, prop.name.view())
            try write_value(&body, &prop.value)
            try body.byte(1 if prop.samples.count > 0 else 0)
            if prop.samples.count > 0:
                try body.uint((u64)prop.samples.count, 4)
                for sample in prop.samples.span():
                    try body.real(sample.time)
                    try write_value(&body, &sample.value)
                    try body.uint((u64)sample.interpolation, 1)
                    try body.byte(sample.handle)
                    try body.uint((u64)(sample.left.count // 2), 4)
                    for value in sample.left.span():
                        try body.real(value)
                    try body.uint((u64)(sample.right.count // 2), 4)
                    for value in sample.right.span():
                        try body.real(value)
            try body.sized(prop.type_name.view())
        try body.uint((u64)element.metadata.count, 4)
        for meta in element.metadata.span():
            try write_index(&body, &table, meta.key.view())
            try write_index(&body, &table, meta.value.view())
        try body.byte(1 if element.override else 0)
        try write_names(&body, &table, &element.removed_properties)
        try write_names(&body, &table, &element.removed_metadata)
    try body.uint((u64)document.connections.count, 4)
    for connection in document.connections.span():
        try write_index(&body, &table, connection.value.view())
        try write_index(&body, &table, connection.key.view())
    try write_names(&body, &table, &document.deletions)
    try write_names(&body, &table, &document.disconnections)
    if document.reorders.count > 0:
        try body.byte(1)
        try body.uint((u64)document.reorders.count, 4)
        for order in document.reorders.span():
            try write_index(&body, &table, order.parent.view())
            try write_names(&body, &table, &order.children)
    if document.globs.count > 0:
        try body.byte(2)
        try body.uint((u64)document.globs.count, 4)
        for glob in document.globs.span():
            try write_index(&body, &table, glob.key.view())
            try write_index(&body, &table, glob.value.view())
    var output: Buffer
    errdefer output.close()
    try output.text("PRSMC\0")
    try output.uint(4, 2)
    try output.uint(1 if compressed else 0, 2)
    if compressed:
        var packed = try compress_bytes(body.bytes())
        defer packed.close()
        try output.put(packed.bytes())
    else:
        try output.put(body.bytes())
    return output

func read_binary(bytes: const u8[], document: Document*) -> !:
    var header = Reader(data = bytes, pos = 6)
    if try header.uint(2) != 4:
        error(unsupported, "only Prism v4 binary crates are supported")
    let flags = try header.uint(2)
    if flags > 1:
        error(unsupported, "unknown Prism crate flags")
    var inflated: Buffer
    defer inflated.close()
    var payload = bytes[header.pos..]
    if flags == 1:
        inflated = try decompress_bytes(payload)
        payload = inflated.bytes()
    var reader = Reader(data = payload)
    var table: List[str]
    defer table.close()
    let string_count = try reader.count(4)
    for i in 0..<string_count:
        try table.push(try reader.text())
    let element_count = try reader.count(25)
    for i in 0..<element_count:
        let path = try read_index(&reader, &table)
        let kind = try read_index(&reader, &table)
        try document.insert(path, kind)
        let property_count = try reader.count(8)
        for p in 0..<property_count:
            let name = try read_index(&reader, &table)
            if document.elements.items[i].property(name) != none:
                error(invalid, "duplicate Prism property")
            var value = try read_value(&reader)
            try document.put_value(path, name, value)
            let prop_index = document.elements.items[i].property(name) else trap("inserted Prism property missing")
            let prop = &document.elements.items[i].properties.items[prop_index]
            let animated = try reader.uint(1)
            if animated > 1:
                error(invalid, "invalid Prism animation flag")
            if animated == 1:
                let count = try reader.count(21)
                for s in 0..<count:
                    var sample = Sample()
                    errdefer sample.close()
                    sample.time = try reader.real()
                    sample.value = try read_value(&reader)
                    let interpolation = try reader.uint(1)
                    if interpolation > 2:
                        error(invalid, "invalid Prism interpolation")
                    sample.interpolation = Interpolation.held if interpolation == 0 else (Interpolation.linear if interpolation == 1 else Interpolation.bezier)
                    sample.handle = (u8)try reader.uint(1)
                    if sample.handle > 3:
                        error(invalid, "invalid Prism handle type")
                    let left = try reader.count(16)
                    for h in 0..<left * 2:
                        try sample.left.push(try reader.real())
                    let right = try reader.count(16)
                    for h in 0..<right * 2:
                        try sample.right.push(try reader.real())
                    if s > 0 and sample.time <= prop.samples.items[s - 1].time:
                        error(invalid, "Prism keyframes must have increasing times")
                    try prop.samples.push(sample)
            prop.type_name = try text_copy(try reader.text())
        let metadata_count = try reader.count(8)
        for m in 0..<metadata_count:
            let key = try read_index(&reader, &table)
            let value = try read_index(&reader, &table)
            let before = document.elements.items[i].metadata.count
            try document.set_metadata(path, key, value)
            if before == document.elements.items[i].metadata.count:
                error(invalid, "duplicate Prism metadata")
        let element = &document.elements.items[i]
        let override = try reader.uint(1)
        if override > 1:
            error(invalid, "invalid Prism override flag")
        element.override = override == 1
        try read_names(&reader, &table, &element.removed_properties)
        try read_names(&reader, &table, &element.removed_metadata)
    let connection_count = try reader.count(8)
    for i in 0..<connection_count:
        let source = try read_index(&reader, &table)
        let target = try read_index(&reader, &table)
        try require_slot(source)
        try require_slot(target)
        # Layers can refer to elements supplied by a base or reference.
        let before = document.connections.count
        try set_pair(&document.connections, target, source)
        if document.connections.count == before:
            error(invalid, "duplicate Prism connection target")
    try read_names(&reader, &table, &document.deletions)
    for path in document.deletions.span():
        try require_element(path.view())
    try read_names(&reader, &table, &document.disconnections)
    for path in document.disconnections.span():
        try require_slot(path.view())
    var seen_reorders = false
    var seen_globs = false
    while reader.remaining() > 0:
        let tag = try reader.uint(1)
        if tag == 1 and not seen_reorders:
            seen_reorders = true
            let count = try reader.count(8)
            for i in 0..<count:
                let parent = try read_index(&reader, &table)
                var children: List[str]
                defer children.close()
                let size = try reader.count(4)
                for j in 0..<size:
                    try children.push(try read_index(&reader, &table))
                let before = document.reorders.count
                try document.reorder(parent, children.span())
                if document.reorders.count == before:
                    error(invalid, "duplicate Prism reorder parent")
        elif tag == 2 and not seen_globs:
            seen_globs = true
            let count = try reader.count(8)
            for i in 0..<count:
                let source = try read_index(&reader, &table)
                let target = try read_index(&reader, &table)
                try document.connect_pattern(source, target)
        else:
            error(unsupported, "unknown or duplicate Prism crate section")


## Legacy LZSS stream: u64 raw length, then LSB-first groups of eight tokens.
## Match = u16(distance-1), u8(length-4); overlapping references are legal.
func decompress_bytes(bytes: const u8[]) -> Buffer!:
    var reader = Reader(data = bytes)
    let size = try reader.uint(8)
    if size > (u64)max_bytes:
        error(limit_exceeded, "Prism decompression exceeds 256 MiB")
    var output: Buffer
    errdefer output.close()
    while output.used < (usize)size:
        let flags = try reader.uint(1)
        for bit in 0..<8:
            if output.used == (usize)size:
                break
            if (flags & ((u64)1 << bit)) == 0:
                try output.byte((u8)try reader.uint(1))
            else:
                let distance = (usize)try reader.uint(2) + 1
                let length = (usize)try reader.uint(1) + 4
                if distance > output.used or length > (usize)size - output.used:
                    error(invalid, "invalid Prism compression back-reference")
                for i in 0..<length:
                    let byte = output.data[output.used - distance]
                    try output.byte(byte)
    if reader.remaining() != 0:
        error(invalid, "trailing Prism compressed bytes")
    return output

func hash_bytes(bytes: const u8[], index: usize) -> usize:
    var value: u32 = 0
    for i in 0..<(usize)4:
        value |= (u32)bytes[index + i] << (i * 8)
    return (usize)((value *% 2654435761) >> 16)

func compress_bytes(bytes: const u8[]) -> Buffer!:
    var output: Buffer
    errdefer output.close()
    try output.uint((u64)bytes.length, 8)
    # One most-recent candidate per hash keeps working memory fixed (512 KiB).
    # The token format is identical to C++; compressed bytes need not be identical.
    let positions = try alloc usize[65536] in memory.heap
    defer free(positions) in memory.heap
    for i in 0..<positions.length:
        positions[i] = 0
    var index: usize = 0
    var bit: usize = 8
    var flag_position: usize = 0
    while index < bytes.length:
        if bit == 8:
            flag_position = output.used
            try output.byte(0)
            bit = 0
        var length: usize = 0
        var distance: usize = 0
        if bytes.length - index >= 4:
            let previous = positions[hash_bytes(bytes, index)]
            if previous > 0 and index - (previous - 1) <= 65536:
                let candidate = previous - 1
                let maximum = 259 if bytes.length - index > 259 else bytes.length - index
                while length < maximum and bytes[candidate + length] == bytes[index + length]:
                    length += 1
                distance = index - candidate
        let end = index + (length if length >= 4 else 1)
        if length >= 4:
            output.data[flag_position] |= (u8)((u32)1 << bit)
            try output.uint((u64)(distance - 1), 2)
            try output.byte((u8)(length - 4))
        else:
            try output.byte(bytes[index])
        while index < end:
            if bytes.length - index >= 4:
                positions[hash_bytes(bytes, index)] = index + 1
            index += 1
        bit += 1
    return output


# One-token lookahead. Numeric/punctuation tokens borrow the input; only escaped
# strings allocate. Returned names remain valid until Parser.close, including
# while later tokens are consumed, so nested parse calls can retain a name.
struct Parser:
    var source: const u8[]
    var position: usize
    var token_start: usize
    var token: str = ""
    var token_kind: u8
    var decoded: List[Buffer]
    var string_budget: usize = max_bytes

    func peek() -> str:
        return self.token

    func kind() -> u8:
        return self.token_kind

    func remaining() -> usize:
        return self.source.length - self.token_start

    mutating func take() -> str!:
        if self.kind() == 0:
            try self.fail("unexpected end of input")
        let text = self.peek()
        try self.advance()
        return text

    func at(text: str) -> bool:
        if self.peek() != text:
            return false
        if text.length == 1 and punctuation(text.bytes[0]):
            return self.kind() == text.bytes[0]
        return self.kind() == 1

    mutating func accept(text: str) -> bool!:
        if not self.at(text):
            return false
        try self.advance()
        return true

    mutating func expect(text: str) -> !:
        if not (try self.accept(text)):
            try self.fail("unexpected token")

    func fail(message: str) -> !:
        error(invalid, message)

    mutating func name() -> str!:
        if self.kind() != 1 and self.kind() != 2:
            try self.fail("expected a name")
        return try self.take()

    mutating func quoted() -> str!:
        if self.kind() != 2:
            try self.fail("expected a quoted string")
        return try self.take()

    mutating func path() -> str!:
        if self.kind() != 4:
            try self.fail("expected a <path>")
        return try self.take()

    mutating func advance() -> !:
        let bytes = self.source
        var pos = self.position
        while pos < bytes.length:
            let byte = bytes[pos]
            if byte == ' ' or byte == '\t' or byte == '\r' or byte == '\n':
                pos += 1
            elif byte == '#':
                while pos < bytes.length and bytes[pos] != '\n':
                    pos += 1
            else:
                break
        self.token_start = pos
        self.token = ""
        self.token_kind = 0
        if pos == bytes.length:
            self.position = pos
            return
        let byte = bytes[pos]
        if byte == '"' or byte == '\'' or byte == '<':
            let end: u8 = '>' if byte == '<' else byte
            self.token_kind = 4 if byte == '<' else (2 if byte == '"' else 3)
            pos += 1
            let start = pos
            var escaped = false
            var closed = false
            while pos < bytes.length:
                let current = bytes[pos]
                if current == end:
                    closed = true
                    break
                pos += 1
                if current == '\\' and byte != '<':
                    if pos == bytes.length:
                        break
                    escaped = true
                    pos += 1
            if not closed:
                error(invalid, "unterminated Prism literal")
            let raw = bytes[start..<pos]
            if escaped:
                var decoded: Buffer
                errdefer decoded.close()
                var i: usize = 0
                while i < raw.length:
                    var current = raw[i]
                    i += 1
                    if current == '\\':
                        current = raw[i]
                        i += 1
                        current = '\n' if current == 'n' else ('\t' if current == 't' else current)
                    try decoded.byte(current)
                let cost = decoded.used + 128
                if cost > self.string_budget:
                    error(limit_exceeded, "Prism decoded string budget exceeded")
                try self.decoded.push(decoded)
                self.string_budget -= cost
                self.token = decoded.view()
            else:
                self.token = (str)raw
            if self.token_kind == 3 and self.token.length != 1:
                error(invalid, "invalid Prism byte character")
            pos += 1
        elif punctuation(byte):
            self.token_kind = byte
            self.token = (str)bytes[pos..<pos + 1]
            pos += 1
        else:
            self.token_kind = 1
            let start = pos
            while pos < bytes.length:
                let current = bytes[pos]
                if current <= 32 or punctuation(current) or current == '"' or current == '\'' or current == '<' or current == '#' or current == '>':
                    break
                pos += 1
            if pos == start:
                error(invalid, "invalid Prism text byte")
            self.token = (str)bytes[start..<pos]
        self.position = pos

    mutating func close():
        close_names(&self.decoded)

func punctuation(byte: u8) -> bool:
    return byte == '{' or byte == '}' or byte == '[' or byte == ']' or byte == '(' or byte == ')' or byte == '=' or byte == ',' or byte == ':'

func tokenize(bytes: const u8[]) -> Parser!:
    var parser = Parser(source = bytes)
    errdefer parser.close()
    try parser.advance()
    return parser

struct TypeSpec:
    var kind: DType = DType.float32
    var shape: List[u32]
    var dynamic: bool
    var tuple_width: usize
    var label: str = ""

    mutating func close():
        self.shape.close()

func dtype_name(dtype: DType) -> str:
    let names: str[14] = ["bool", "char", "int8", "int16", "int32", "int64", "uint8", "uint16", "uint32", "uint64", "float32", "float64", "str", "float16"]
    return names[(usize)dtype]

func type_spec(name: str) -> TypeSpec!:
    var spec = TypeSpec()
    errdefer spec.close()
    for i in 0..<(u64)14:
        let kind = try dtype_from(i)
        if name == dtype_name(kind):
            spec.kind = kind
            return spec
    if name == "float" or name == "int":
        spec.kind = DType.float32 if name == "float" else DType.int64
        return spec
    if name == "float2" or name == "float3" or name == "matrix" or name == "spectrum":
        if name == "matrix":
            try spec.shape.push(2)
            try spec.shape.push(3)
            spec.tuple_width = 6
        else:
            let size: u32 = 2 if name == "float2" else (3 if name == "float3" else 32)
            try spec.shape.push(size)
            spec.tuple_width = 0 if name == "spectrum" else (usize)size
        return spec
    spec.label = name
    if name.length == 5 and strings.starts_with(name, "vec") and name.bytes[3] >= '2' and name.bytes[3] <= '4':
        let code = name.bytes[4]
        if code != 'f' and code != 'd' and code != 'h' and code != 'i':
            error(unsupported, "unknown Prism vector type")
        spec.kind = DType.float64 if code == 'd' else (DType.float16 if code == 'h' else (DType.int32 if code == 'i' else DType.float32))
        try spec.shape.push((u32)(name.bytes[3] - '0'))
        return spec
    if name == "matrix2d" or name == "matrix3d" or name == "matrix4d" or name == "matrix4f":
        spec.kind = DType.float32 if name == "matrix4f" else DType.float64
        try spec.shape.push((u32)(name.bytes[6] - '0'))
        try spec.shape.push((u32)(name.bytes[6] - '0'))
        return spec
    if name == "quath" or name == "quatf" or name == "quatd":
        spec.kind = DType.float16 if name == "quath" else (DType.float64 if name == "quatd" else DType.float32)
        try spec.shape.push(4)
        return spec
    if name == "point3f" or name == "normal3f" or name == "vector3f" or name == "color3f" or name == "color4f" or name == "texCoord2f" or name == "texCoord3f":
        try spec.shape.push(4 if name == "color4f" else (2 if name == "texCoord2f" else 3))
        return spec
    error(unsupported, "unknown Prism value type")

func parse_leaf(parser: Parser*, value: ValueData*) -> !:
    let kind = parser.kind()
    let token = try parser.take()
    if value.kind == DType.string:
        if kind != 2:
            try parser.fail("expected a string value")
        try value.payload.sized(token)
    elif value.kind == DType.character:
        if kind != 3:
            try parser.fail("expected a byte character")
        try value.payload.byte(token.bytes[0])
    elif value.kind == DType.boolean:
        if kind != 1 or (token != "true" and token != "false"):
            try parser.fail("expected a boolean")
        try value.payload.byte(1 if token == "true" else 0)
    elif floating(value.kind):
        if kind != 1:
            try parser.fail("expected a number")
        var number = try strings.parse_f64(token)
        if not math.is_finite(number):
            number = 0.0
        try append_number(&value.payload, value.kind, number)
    elif value.kind == DType.int8 or value.kind == DType.int16 or value.kind == DType.int32 or value.kind == DType.int64:
        if kind != 1:
            try parser.fail("expected an integer")
        let number = strings.parse_i64(token) else error(invalid, "invalid Prism signed integer")
        let width = dtype_width(value.kind)
        if width < 8:
            let maximum = ((i64)1 << (width * 8 - 1)) - 1
            if number < -maximum - 1 or number > maximum:
                try parser.fail("signed integer exceeds its dtype")
        try value.payload.uint((u64)number, width)
    else:
        if kind != 1:
            try parser.fail("expected an unsigned integer")
        let number = strings.parse_u64(token) else error(invalid, "invalid Prism unsigned integer")
        let width = dtype_width(value.kind)
        if width < 8 and number >= ((u64)1 << (width * 8)):
            try parser.fail("unsigned integer exceeds its dtype")
        try value.payload.uint(number, width)

func parse_nested(parser: Parser*, value: ValueData*, depth: usize) -> !:
    try parser.expect("[")
    let count = (usize)value.shape.items[depth]
    for i in 0..<count:
        if depth + 1 == value.shape.count:
            try parse_leaf(parser, value)
        else:
            try parse_nested(parser, value, depth + 1)
        if i + 1 < count:
            try parser.expect(",")
        else:
            discard(try parser.accept(","))
    try parser.expect("]")

func parse_tuple(parser: Parser*, value: ValueData*, count: usize) -> !:
    try parser.expect("(")
    for i in 0..<count:
        try parse_leaf(parser, value)
        if i + 1 < count:
            try parser.expect(",")
        else:
            discard(try parser.accept(","))
    try parser.expect(")")

func parse_value(parser: Parser*, spec: const TypeSpec*) -> ValueData!:
    var value = try value_header(spec.kind, spec.shape.span())
    errdefer value.close()
    if spec.dynamic:
        try parser.expect("[")
        var count: u32 = 0
        while not parser.at("]"):
            if count >= (u32)max_items:
                error(limit_exceeded, "Prism dynamic array limit exceeded")
            if spec.tuple_width > 0:
                try parse_tuple(parser, &value, spec.tuple_width)
            else:
                try parse_leaf(parser, &value)
            count += 1
            if not (try parser.accept(",")):
                break
        try parser.expect("]")
        value.shape.items[0] = count
    elif spec.tuple_width > 0:
        try parse_tuple(parser, &value, spec.tuple_width)
    elif value.shape.count > 0:
        if value.count() > parser.remaining():
            error(invalid, "Prism shape exceeds remaining source bytes")
        try parse_nested(parser, &value, 0)
    else:
        try parse_leaf(parser, &value)
    return value

func parse_handles(parser: Parser*, values: List[f64]*) -> !:
    try parser.expect("[")
    while not parser.at("]"):
        let number = try strings.parse_f64(try parser.take())
        if not math.is_finite(number):
            try parser.fail("non-finite handle")
        try values.push(number)
        if not (try parser.accept(",")):
            break
    try parser.expect("]")
    if values.count % 2 != 0:
        try parser.fail("handles need time/value pairs")

func parse_property(parser: Parser*, document: Document*, path: str) -> !:
    let type_name = try parser.name()
    var spec = try type_spec(type_name)
    defer spec.close()
    if try parser.accept("["):
        if spec.label != "":
            try parser.fail("catalog aliases have fixed shapes")
        if try parser.accept("]"):
            spec.dynamic = true
            var shape: List[u32]
            errdefer shape.close()
            try shape.push(0)
            for dimension in spec.shape.span():
                try shape.push(dimension)
            spec.shape.close()
            spec.shape = shape
        else:
            if spec.shape.count > 0:
                try parser.fail("legacy aggregate already has a shape")
            while true:
                let dimension = strings.parse_u64(try parser.take()) else error(invalid, "invalid Prism dimension")
                if dimension > 4294967295 or spec.shape.count >= 16:
                    try parser.fail("invalid Prism rank or dimension")
                try spec.shape.push((u32)dimension)
                if not (try parser.accept(",")):
                    break
            try parser.expect("]")
    let quoted_name = parser.kind() == 2
    var name = try parser.name()
    var animated = false
    if not quoted_name and strings.ends_with(name, ".timeSamples"):
        animated = true
        name = (str)name.bytes[..<name.length - 12]
    elif try parser.accept(".timeSamples"):
        animated = true
    try parser.expect("=")
    if not animated:
        let value = try parse_value(parser, &spec)
        try document.put_value(path, name, value, spec.label)
        return
    let element_index = try document.require(path)
    if document.elements.items[element_index].property(name) == none:
        var zero = try value_header(spec.kind, spec.shape.span())
        zero.payload.reserve(zero.count() * (4 if spec.kind == DType.string else dtype_width(spec.kind))) catch failure:
            zero.close()
            error(failure.code, failure.message)
        zero.payload.used = zero.count() * (4 if spec.kind == DType.string else dtype_width(spec.kind))
        memory.set(zero.payload.data[..<zero.payload.used], 0)
        if type_name == "matrix":
            memory.write[f32](&zero.payload.data[0], 1.0)
            memory.write[f32](&zero.payload.data[12], 1.0)
        try document.put_value(path, name, zero, spec.label)
    let prop_index = document.elements.items[element_index].property(name) else trap("Prism sample default missing")
    let prop = &document.elements.items[element_index].properties.items[prop_index]
    try parser.expect("{")
    while not parser.at("}"):
        var sample = Sample()
        errdefer sample.close()
        sample.time = try strings.parse_f64(try parser.take())
        if not math.is_finite(sample.time):
            try parser.fail("non-finite keyframe time")
        try parser.expect(":")
        sample.value = try parse_value(parser, &spec)
        if try parser.accept("("):
            while not parser.at(")"):
                let key = try parser.name()
                try parser.expect("=")
                if key == "interp":
                    let mode = try parser.name()
                    if mode != "held" and mode != "linear" and mode != "bezier":
                        try parser.fail("unknown interpolation")
                    sample.interpolation = Interpolation.held if mode == "held" else (Interpolation.linear if mode == "linear" else Interpolation.bezier)
                elif key == "handle":
                    let mode = try parser.name()
                    if mode != "auto" and mode != "vector" and mode != "aligned" and mode != "free":
                        try parser.fail("unknown handle type")
                    sample.handle = 0 if mode == "auto" else (1 if mode == "vector" else (2 if mode == "aligned" else 3))
                elif key == "left":
                    try parse_handles(parser, &sample.left)
                elif key == "right":
                    try parse_handles(parser, &sample.right)
                else:
                    try parser.fail("unknown keyframe option")
                if not (try parser.accept(",")):
                    break
            try parser.expect(")")
        try insert_sample(prop, sample)
        if not (try parser.accept(",")):
            break
    try parser.expect("}")

func parse_directive(parser: Parser*, document: Document*, path: str, depth: usize) -> !:
    if parser.kind() != 1:
        try parser.fail("expected a directive or value type")
    let directive = parser.peek()
    if directive == "def" or directive == "over":
        if depth >= max_depth:
            error(limit_exceeded, "Prism element nesting limit exceeded")
        discard(try parser.take())
        var kind: str = ""
        var name: str = ""
        var named = false
        if parser.kind() == 2:
            let first = try parser.take()
            if parser.kind() == 2:
                kind = first
                name = try parser.take()
                named = true
            elif valid_name(first):
                name = first
                named = true
            else:
                kind = first
        elif not parser.at("{"):
            kind = try parser.name()
            if parser.kind() == 2:
                name = try parser.take()
                named = true
        var anonymous_name: u8[64]
        if not named:
            var count: usize = 0
            for element in document.elements.span():
                if parent_path(element.path.view()) == path:
                    count += 1
            name = try format(anonymous_name, f"[{count}]")
        var child = try joined(path, name)
        defer child.close()
        try document.add(child.view(), kind, directive == "over")
        try parser.expect("{")
        while not parser.at("}"):
            try parse_directive(parser, document, child.view(), depth + 1)
        try parser.expect("}")
    elif directive == "delete" or directive == "disconnect":
        discard(try parser.take())
        let target = try parser.quoted()
        if directive == "delete":
            try document.mark_deleted(target)
        else:
            try document.mark_disconnected(target)
    elif directive == "reorder":
        discard(try parser.take())
        let parent = try parser.quoted()
        try parser.expect("=")
        try parser.expect("[")
        var children: List[str]
        defer children.close()
        while not parser.at("]"):
            try children.push(try parser.quoted())
            if not (try parser.accept(",")):
                break
        try parser.expect("]")
        try document.reorder(parent, children.span())
    elif directive == "connect":
        discard(try parser.take())
        var target: Buffer
        defer target.close()
        if parser.kind() == 4:
            target = try text_copy(try parser.path())
        else:
            target = try joined(path, try parser.name(), ".")
        try parser.expect("=")
        let source = try parser.path()
        try require_slot(source)
        if strings.find(target.view(), "*") != none or strings.find(target.view(), "?") != none:
            try document.connect_pattern(source, target.view())
        else:
            try require_slot(target.view())
            try set_pair(&document.connections, target.view(), source)
    elif directive == "string":
        discard(try parser.take())
        let key = try parser.name()
        try parser.expect("=")
        try document.set_metadata(path, key, try parser.quoted())
    elif directive == "reference":
        discard(try parser.take())
        try document.set_metadata(path, "reference", try parser.quoted())
        if parser.kind() == 2:
            try document.set_metadata(path, "referencePath", try parser.quoted())
    elif directive == "unset":
        discard(try parser.take())
        let metadata = try parser.accept("string")
        try document.mark_unset(path, try parser.name(), metadata)
    elif path == "/":
        try parser.fail("expected a document directive")
    elif strings.ends_with(directive, ".connect"):
        let name = try parser.take()
        var target = try joined(path, (str)name.bytes[..<name.length - 8], ".")
        defer target.close()
        try parser.expect("=")
        let source = try parser.path()
        try require_slot(source)
        try require_slot(target.view())
        try set_pair(&document.connections, target.view(), source)
    else:
        try parse_property(parser, document, path)

func read_text(bytes: const u8[], document: Document*) -> !:
    let trimmed = strings.trim(try str(bytes))
    let end = strings.find(trimmed, "\n") else trimmed.length
    let header = strings.trim((str)trimmed.bytes[..<end])
    if header != "#prisma 1.0" and header != "#prisma 2.0" and header != "#prisma 3.0" and header != "#prisma 4.0":
        error(unsupported, "unsupported Prism text version")
    var parser = try tokenize(bytes)
    defer parser.close()
    while parser.kind() != 0:
        try parse_directive(&parser, document, "/", 0)

func quote(out: Buffer*, text: str, delimiter: u8 = '"') -> !:
    try out.byte(delimiter)
    for byte in text.bytes:
        if byte == delimiter or byte == '\\':
            try out.byte('\\')
            try out.byte(byte)
        elif byte == '\n':
            try out.text("\\n")
        elif byte == '\t':
            try out.text("\\t")
        else:
            try out.byte(byte)
    try out.byte(delimiter)

func bare_identifier(text: str) -> bool:
    return valid_name(text) and not (text.bytes[0] >= '0' and text.bytes[0] <= '9')

func write_name(out: Buffer*, text: str) -> !:
    if bare_identifier(text):
        try out.text(text)
    else:
        try quote(out, text)

func indent(out: Buffer*, depth: usize) -> !:
    for i in 0..<depth * 4:
        try out.byte(' ')

func write_float(out: Buffer*, value: f64) -> !:
    var scratch: u8[64]
    try out.text(try strings.format_f64(value if math.is_finite(value) else 0.0, scratch))

func write_leaf(out: Buffer*, value: const ValueData*, index: usize, strings_reader: Reader*) -> !:
    var scratch: u8[80]
    if value.kind == DType.string:
        try quote(out, try strings_reader.text())
    elif value.kind == DType.character:
        if value.bits(index) > 127:
            error(unsupported, "use binary for non-ASCII byte characters")
        let byte: u8[1] = [(u8)value.bits(index)]
        try quote(out, (str)byte, '\'')
    elif value.kind == DType.boolean:
        try out.text("true" if value.bits(index) != 0 else "false")
    elif floating(value.kind):
        try write_float(out, try value.number(index))
    elif value.kind == DType.int8 or value.kind == DType.int16 or value.kind == DType.int32 or value.kind == DType.int64:
        try out.text(try strings.format_i64(value.signed(index), scratch))
    else:
        try out.text(try strings.format_u64(value.bits(index), scratch))

func write_nested(out: Buffer*, value: const ValueData*, depth: usize, index: usize*, reader: Reader*) -> !:
    if depth == value.shape.count:
        try write_leaf(out, value, *index, reader)
        *index += 1
        return
    try out.byte('[')
    for i in 0..<(usize)value.shape.items[depth]:
        if i > 0:
            try out.text(", ")
        try write_nested(out, value, depth + 1, index, reader)
    try out.byte(']')

func write_literal(out: Buffer*, value: const ValueData*) -> !:
    var reader = Reader(data = value.payload.bytes())
    var index: usize = 0
    try write_nested(out, value, 0, &index, &reader)

func write_type(out: Buffer*, prop: const Property*) -> !:
    if prop.type_name.used > 0:
        var spec = try type_spec(prop.type_name.view())
        defer spec.close()
        var declared = try value_header(spec.kind, spec.shape.span())
        defer declared.close()
        if spec.label == "" or not same_shape(&declared, &prop.value):
            error(invalid, "Prism catalog label does not match its value")
        try out.text(prop.type_name.view())
        return
    try out.text(dtype_name(prop.value.kind))
    if prop.value.shape.count > 0:
        try out.byte('[')
        for i in 0..<prop.value.shape.count:
            if i > 0:
                try out.byte(',')
            var scratch: u8[32]
            try out.text(try strings.format_u64((u64)prop.value.shape.items[i], scratch))
        try out.byte(']')

func write_handles(out: Buffer*, name: str, values: const List[f64]*) -> !:
    if values.count == 0:
        return
    try out.text(name)
    try out.text(" = [")
    for i in 0..<values.count:
        if i > 0:
            try out.text(", ")
        try write_float(out, values.items[i])
    try out.byte(']')

func write_element(out: Buffer*, document: const Document*, element: const Element*, depth: usize) -> !:
    if depth >= max_depth:
        error(limit_exceeded, "Prism element nesting limit exceeded")
    try indent(out, depth)
    try out.text("over" if element.override else "def")
    if element.kind.used > 0:
        try out.byte(' ')
        try write_name(out, element.kind.view())
    let name = path_name(element.path.view())
    if anonymous(name):
        var position: usize = 0
        for sibling in document.elements.span():
            if sibling.path.view() == element.path.view():
                break
            if parent_path(sibling.path.view()) == parent_path(element.path.view()):
                position += 1
        var scratch: u8[64]
        if name != try format(scratch, f"[{position}]"):
            error(invalid, "anonymous Prism path does not match its sibling position")
    else:
        try out.byte(' ')
        try quote(out, name)
    try out.text(" {\n")
    for prop in element.properties.span():
        try indent(out, depth + 1)
        try write_type(out, &prop)
        try out.byte(' ')
        try write_name(out, prop.name.view())
        try out.text(" = ")
        try write_literal(out, &prop.value)
        try out.byte('\n')
        if prop.samples.count > 0:
            try indent(out, depth + 1)
            try write_type(out, &prop)
            try out.byte(' ')
            try write_name(out, prop.name.view())
            try out.text(".timeSamples = {\n")
            for sample in prop.samples.span():
                if not same_shape(&prop.value, &sample.value):
                    error(unsupported, "use binary for samples with varying dtype or shape")
                try indent(out, depth + 2)
                try write_float(out, sample.time)
                try out.text(": ")
                try write_literal(out, &sample.value)
                if sample.interpolation != Interpolation.linear or sample.handle != 0 or sample.left.count > 0 or sample.right.count > 0:
                    try out.text(" (interp = ")
                    try out.text("held" if sample.interpolation == Interpolation.held else ("linear" if sample.interpolation == Interpolation.linear else "bezier"))
                    if sample.handle != 0 or sample.left.count > 0 or sample.right.count > 0:
                        let modes: str[4] = ["auto", "vector", "aligned", "free"]
                        try out.text(", handle = ")
                        try out.text(modes[(usize)sample.handle])
                        try write_handles(out, ", left", &sample.left)
                        try write_handles(out, ", right", &sample.right)
                    try out.byte(')')
                try out.text(",\n")
            try indent(out, depth + 1)
            try out.text("}\n")
    for meta in element.metadata.span():
        try indent(out, depth + 1)
        try out.text("string ")
        try write_name(out, meta.key.view())
        try out.text(" = ")
        try quote(out, meta.value.view())
        try out.byte('\n')
    for removed in element.removed_properties.span():
        try indent(out, depth + 1)
        try out.text("unset ")
        try write_name(out, removed.view())
        try out.byte('\n')
    for removed in element.removed_metadata.span():
        try indent(out, depth + 1)
        try out.text("unset string ")
        try write_name(out, removed.view())
        try out.byte('\n')
    for child in document.elements.span():
        if parent_path(child.path.view()) == element.path.view():
            try write_element(out, document, &child, depth + 1)
    try indent(out, depth)
    try out.text("}\n")

func write_text(document: const Document*) -> Buffer!:
    var output: Buffer
    errdefer output.close()
    for item in document.elements.span():
        let parent = parent_path(item.path.view())
        if parent != "/" and not document.contains(parent):
            error(unsupported, "text needs explicit ancestors; use binary for sparse documents")
    try output.text("#prisma 4.0\n")
    for element in document.elements.span():
        if parent_path(element.path.view()) == "/":
            try write_element(&output, document, &element, 0)
    for connection in document.connections.span():
        try output.text("connect <")
        try output.text(connection.key.view())
        try output.text("> = <")
        try output.text(connection.value.view())
        try output.text(">\n")
    for path in document.deletions.span():
        try output.text("delete ")
        try quote(&output, path.view())
        try output.byte('\n')
    for path in document.disconnections.span():
        try output.text("disconnect ")
        try quote(&output, path.view())
        try output.byte('\n')
    for glob in document.globs.span():
        try output.text("connect <")
        try output.text(glob.value.view())
        try output.text("> = <")
        try output.text(glob.key.view())
        try output.text(">\n")
    for order in document.reorders.span():
        try output.text("reorder ")
        try quote(&output, order.parent.view())
        try output.text(" = [")
        for i in 0..<order.children.count:
            if i > 0:
                try output.text(", ")
            try quote(&output, order.children.items[i].view())
        try output.text("]\n")
    return output


struct Entry:
    var name: str
    var mime: str
    var kind: u8
    var offset: usize
    var size: usize

func write_package(document: const Document*, compressed: bool) -> Buffer!:
    var scene = try write_binary(document, compressed)
    defer scene.close()
    var header_size: usize = 14 + 25 + 5
    for asset in document.assets.span():
        let extra = 25 + asset.path.used + asset.mime.used
        header_size = header_size +? extra else error(limit_exceeded, "Prism package TOC overflow")
    var output: Buffer
    errdefer output.close()
    try output.text("PRSMZ\0")
    try output.uint(4, 2)
    try output.uint(0, 2)
    try output.uint((u64)(document.assets.count + 1), 4)
    var offset = header_size
    for asset in document.assets.span():
        try output.sized(asset.path.view())
        try output.byte(2)
        try output.sized(asset.mime.view())
        try output.uint((u64)offset, 8)
        try output.uint((u64)asset.bytes.used, 8)
        offset = offset +? asset.bytes.used else error(limit_exceeded, "Prism package size overflow")
    try output.sized("scene")
    try output.byte(1)
    try output.sized("")
    try output.uint((u64)offset, 8)
    try output.uint((u64)scene.used, 8)
    for asset in document.assets.span():
        try output.put(asset.bytes.bytes())
    try output.put(scene.bytes())
    return output

func read_package(bytes: const u8[], document: Document*) -> !:
    var reader = Reader(data = bytes, pos = 6)
    if try reader.uint(2) != 4:
        error(unsupported, "only Prism v4 packages are supported")
    if try reader.uint(2) != 0:
        error(unsupported, "unknown Prism package flags")
    let count = try reader.count(25)
    var entries: List[Entry]
    defer entries.close()
    var scene: usize? = none
    for i in 0..<count:
        let name = try reader.text()
        let kind = (u8)try reader.uint(1)
        let mime = try reader.text()
        let offset = try reader.uint(8)
        let size = try reader.uint(8)
        if offset > (u64)bytes.length or size > (u64)bytes.length - offset:
            error(invalid, "Prism package blob is outside its input")
        if kind > 2:
            error(unsupported, "unknown Prism package entry kind")
        for entry in entries.span():
            if entry.name == name:
                error(invalid, "duplicate Prism package entry name")
        if kind < 2:
            if scene != none or name != "scene" or mime != "":
                error(invalid, "Prism package must contain one named scene")
            scene = i
        else:
            try require_element(name)
        try entries.push(Entry(name = name, kind = kind, mime = mime, offset = (usize)offset, size = (usize)size))
    for i in 0..<entries.count:
        let a = entries.items[i]
        if a.offset < reader.pos:
            error(invalid, "Prism package blob overlaps its table")
        for j in 0..<i:
            let b = entries.items[j]
            if a.size > 0 and b.size > 0 and a.offset < b.offset + b.size and b.offset < a.offset + a.size:
                error(invalid, "overlapping Prism package blobs")
    let index = scene else error(invalid, "Prism package has no scene")
    let entry = entries.items[index]
    let payload = bytes[entry.offset..<entry.offset + entry.size]
    let encoding = detect(payload)
    if encoding != (Encoding.text if entry.kind == 0 else Encoding.binary):
        error(invalid, "Prism scene kind does not match its magic")
    # No recursive package scenes: depth and asset ownership stay unambiguous.
    try read_document(payload, document)
    for asset in entries.span():
        if asset.kind == 2:
            try document.set_asset(asset.name, bytes[asset.offset..<asset.offset + asset.size], asset.mime)
