pub type Document = document.Document
pub type ElementHandle = handles.ElementHandle
pub let element_handle_type = handles.element_handle_type

pub func edit(doc: interop.Reference[Document], path: str) -> interop.Reference[ElementHandle]!:
    return try handles.edit(doc, path)

pub func define(doc: interop.Reference[Document], path: str, kind: str = "") -> interop.Reference[ElementHandle]!:
    return try handles.define(doc, path, kind)
pub type EvalKey = caching.EvalKey
pub type ValueCache = cache_api.ValueCache
pub type DocumentCache = cache_api.DocumentCache
pub let value_cache_type = cache_api.value_cache_type
pub let document_cache_type = cache_api.document_cache_type

pub func compress(bytes: const u8[]) -> interop.Reference[storage.Blob]!:
    return try storage.own_blob(try compression.compress_bytes(bytes))

pub func decompress(bytes: const u8[]) -> interop.Reference[storage.Blob]!:
    return try storage.own_blob(try compression.decompress_bytes(bytes))
pub type Path = path_value.Path
pub let path_type = path_value.path_type

pub func valid_pattern(pattern: str) -> bool:
    return pattern_ops.valid_pattern(pattern)

pub func pattern_prefix(pattern: str) -> str:
    return pattern_ops.prefix(pattern)

pub func has_wildcard(pattern: str) -> bool:
    return pattern_ops.has_wildcard(pattern)
pub type AppSettings = settings.AppSettings
pub let app_settings_type = settings.app_settings_type
pub type TokenClass = highlighting.TokenClass
pub type TokenSpan = highlighting.TokenSpan
pub type TokenSpans = highlighting.TokenSpans
pub let token_spans_type = highlighting.token_spans_type

pub func highlight_line(line: str, codec: codecs.Codec) -> interop.Reference[TokenSpans]!:
    return try highlighting.highlight_line(line, codec)

pub func load(path: str, codec: codecs.Codec = codecs.Codec.auto) -> interop.Reference[Document]!:
    return try file_io.load(path, codec)

pub func save(doc: interop.Reference[Document], path: str, codec: codecs.Codec = codecs.Codec.auto) -> !:
    try file_io.save(doc, path, codec)

pub func write_durable(path: str, bytes: const u8[]) -> !:
    try file_io.write(path, bytes)
pub type EventLog = event_log.EventLog
pub type Changes = event_log.Changes
pub let event_log_type = event_log.event_log_type
