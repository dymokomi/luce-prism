pub func valid_path(path: str) -> bool:
    return path_ops.valid_path(path)

pub func element_path(path: str) -> str:
    return path_ops.element_path(path)

pub func parent_path(path: str) -> str:
    return path_ops.parent_path(path)

pub func path_name(path: str) -> str:
    return path_ops.path_name(path)

pub func is_anonymous(name: str) -> bool:
    return path_ops.anonymous(name)

pub func is_descendant(path: str, root: str) -> bool:
    return path_ops.is_descendant(path, root)

pub func detect(bytes: const u8[]) -> Encoding:
    return encoding.detect(bytes)

pub func matches(pattern: str, path: str) -> bool:
    return pattern_ops.matches(pattern, path)

pub type ReferenceLibrary = references.ReferenceLibrary
pub let library_type = references.library_type

pub func compose_file(path: str) -> interop.Reference[Document]!:
    return try references.compose_file(path)

pub func materialize_file(path: str) -> interop.Reference[Document]!:
    return try references.compose_file(path)

pub type MergeResult = merging.MergeResult
pub type LayerStack = merging.LayerStack
pub type Layer = delta.Layer
pub let merge_type = merging.merge_type
pub let layer_stack_type = merging.layer_stack_type
pub let layer_type = delta.layer_type

pub func layer_from(source: interop.Reference[Document]) -> interop.Reference[Layer]!:
    return try delta.own_layer(try delta.from_document((try source.get()).view_data()))

pub func make_layer() -> interop.Reference[Layer]!:
    return try delta.own_layer(delta.Layer())

pub func layer_put_element(layer: interop.Reference[Layer], path: str, override: bool = false, deleted: bool = false) -> !:
    try (try layer.get()).put(path, delta.Cell.element, "", delta.Op(deleted = deleted, override = override))

pub func layer_visible(base: interop.Reference[Document], layer: interop.Reference[Layer], path: str) -> bool!:
    return delta.visible((try base.get()).view_data(), try layer.get(), none, path)

pub func layer_visible2(base: interop.Reference[Document], first: interop.Reference[Layer], second: interop.Reference[Layer], path: str) -> bool!:
    return delta.visible((try base.get()).view_data(), try first.get(), try second.get(), path)

pub func layer_has_child(base: interop.Reference[Document], layer: interop.Reference[Layer], parent: str, child: str) -> bool!:
    var kids = try delta.children((try base.get()).view_data(), try layer.get(), none, parent)
    defer kids.close()
    for path in kids.span():
        if path == child:
            return true
    return false

pub func layer_has_child2(base: interop.Reference[Document], first: interop.Reference[Layer], second: interop.Reference[Layer], parent: str, child: str) -> bool!:
    var kids = try delta.children((try base.get()).view_data(), try first.get(), try second.get(), parent)
    defer kids.close()
    for path in kids.span():
        if path == child:
            return true
    return false

pub func layer_has_property(base: interop.Reference[Document], layer: interop.Reference[Layer], path: str, name: str) -> bool!:
    return delta.has_property((try base.get()).view_data(), try layer.get(), none, path, name)

pub func merge(base: interop.Reference[Document], a: interop.Reference[Document], b: interop.Reference[Document]) -> interop.Reference[MergeResult]!:
    return try merging.merge(base, a, b)

pub func decode(bytes: const u8[], codec: Codec = Codec.auto) -> interop.Reference[Document]!:
    return try codecs.decode(bytes, codec)

pub func encode(doc: interop.Reference[Document], codec: Codec = Codec.prisma, compressed: bool = false) -> interop.Reference[Blob]!:
    return try codecs.encode(doc, codec, compressed)

pub func codec_name(codec: Codec) -> str:
    return codecs.codec_name(codec)

pub func codec_by_name(name: str) -> Codec?:
    return codecs.codec_by_name(name)

pub func codec_for_path(path: str) -> Codec!:
    return try codecs.codec_for_path(path)

pub func document_lens(doc: interop.Reference[Document]) -> Codec!:
    return try codecs.document_lens(doc)

pub func set_document_lens(doc: interop.Reference[Document], codec: Codec) -> !:
    try codecs.set_document_lens(doc, codec)

pub func compute(doc: interop.Reference[Document], time: f64 = 0.0) -> interop.Reference[Document]!:
    return try evaluation.compute(doc, time)

pub func compute_slot(doc: interop.Reference[Document], slot: str, time: f64 = 0.0) -> interop.Reference[Value]!:
    return try evaluation.compute_slot(doc, slot, time)

pub func local_matrix(doc: interop.Reference[Document], path: str, time: f64 = 0.0) -> Affine2!:
    return try transforms.local_matrix(doc, path, time)

pub func world_matrix(doc: interop.Reference[Document], path: str, time: f64 = 0.0) -> Affine2!:
    return try transforms.world_matrix(doc, path, time)

pub func is_visible(doc: interop.Reference[Document], path: str, time: f64 = 0.0) -> bool!:
    return try transforms.is_visible(doc, path, time)
