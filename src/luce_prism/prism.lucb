pub func join_on(left: interop.Reference[Query], left_field: str, right: interop.Reference[Query], right_field: str, kind: JoinType = JoinType.inner) -> interop.Reference[JoinResult]!:
    return try joining.join_on(left, left_field, right, right_field, kind)

pub func join_by_connection(doc: interop.Reference[Document], left: interop.Reference[Query], slot: str) -> interop.Reference[JoinResult]!:
    return try joining.join_by_connection(doc, left, slot)
