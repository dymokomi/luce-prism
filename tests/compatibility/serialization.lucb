pub func run() -> !:
    let topology = try prism.Document.parse("#prisma 4.0\ndef \"mesh\" { float[] width = [1,2,3,4] float[] width.timeSamples = { 0: [1,2], 10: [] } float2[] points = [(0,0)] float2[] points.timeSamples = { 0: [(0,0),(1,1)], 10: [] } }")
    defer topology.release()
    for mode in 0..<(usize)5:
        let back = try roundtrip(topology, mode)
        defer back.release()
        let width = try back.value().sample_value_at("/mesh", "width", 0)
        defer width.release()
        assert(width.value().count() == 2)
    try doc_round_trip_structural()
    try geometry_arrays_round_trip_text_and_binary()
    try string_metadata_round_trips_text_and_binary()
    try namespaced_property_names_round_trip_text()
    try non_identifier_keys_round_trip_text()
    try non_identifier_property_names_round_trip_text()
    try every_dtype_and_shape_round_trips_text_and_binary()
    try general_dtypes_round_trip_text_and_binary()
    try named_type_aliases_round_trip()
    try connect_directive_relative_and_wildcard()
    try doc_round_trip_byte_stable()
    try bezier_keyframe_handles_round_trip()
    try format_is_versioned_and_uuid_free()
    try animated_values_resolve_after_load()
    try usda_text_shape_is_clean()
    try binary_crate_round_trip_structural()
    try binary_crate_round_trip_byte_stable()
    try text_and_binary_encodings_describe_the_same_stage()
    try parses_hand_written_input_with_comments_and_whitespace()
    try text_parser_rejects_implausible_array_shapes()
    try values_read_is_bounded_by_buffer()
    try binary_crate_compression_round_trips()
    try parse_errors_are_located()
    try non_identifier_type_tokens_round_trip_text()
    try every_type_round_trips_through_text()
    try every_type_round_trips_through_binary()
    try every_type_round_trips_through_package_binary_scene()
    try every_type_round_trips_through_package_text_scene()
    try bezier_keyframe_metadata_survives_round_trip()
    try all_three_encodings_describe_the_same_stage()
    try deserialize_rejects_malformed()
    try int64_property_round_trips_exactly()
    print("PASS 32 legacy serialization cases across five encoding variants")
