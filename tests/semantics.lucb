import compatibility.animation as animation
import compatibility.evaluation as evaluation
import compatibility.transforms as transforms
import compatibility.diff as diffs
import compatibility.merge as merging
import compatibility.layers as layers
import compatibility.references as references

pub func main(arguments: str[]) -> i32!:
    assert(arguments.length == 2)
    try animation.run()
    try evaluation.run()
    try transforms.run()
    try layers.run()
    try diffs.run()
    try merging.run()
    try references.run(arguments[1])
    return 0
