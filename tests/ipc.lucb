## Owner listen + Store.connect. The client never opens the journal.
import prism
import files
import process
import os
import thread
import interop
import c

func ipc_dir() -> str:
    return "/tmp/luce-prism-ipc-test"

func ipc_db() -> str:
    return "/tmp/luce-prism-ipc-test/root.db"

func ipc_sock() -> str:
    return "/tmp/luce-prism-ipc-test/root.db.sock"

func reset_ipc() -> !:
    files.delete_path(ipc_dir(), true) catch failure:
        discard(failure)
    try files.make_directory(ipc_dir())

func run_owner(dbpath: str) -> !:
    let store = try prism.Store.open(dbpath, token = "secret")
    defer store.release()
    try store.value().listen()
    print("READY")
    try store.value().serve()

func wait_socket() -> !:
    var i: usize = 0
    while i < 250:
        if files.exists((c.str)ipc_sock()):
            return
        thread.sleep(20)
        i += 1
    error(prism.timed_out, "Prism owner socket did not appear")

func run_client() -> !:
    var denied = false
    let rejected: interop.Reference[prism.Store]? = prism.Store.connect(ipc_sock(), "wrong") catch failure:
        assert(failure.code == prism.invalid)
        denied = true
        recover none
    if let extra = rejected:
        extra.release()
        assert(false)
    assert(denied)
    let store = try prism.Store.connect(ipc_sock(), "secret")
    defer store.release()
    let tx = try store.value().begin()
    defer tx.release()
    try tx.value().add("/notes", "file")
    let text = try prism.Value.text("hello")
    defer text.release()
    try tx.value().set("/notes", "text", text)
    discard(try tx.value().commit())
    let snap = try store.value().snapshot()
    defer snap.release()
    let got = try snap.value().get("/notes", "text")
    defer got.release()
    assert(try got.value().text_at() == "hello")
    let kids = try snap.value().children("/")
    defer kids.release()
    assert(kids.value().count() == 1)
    let look = try store.value().lookup("/notes")
    defer look.release()
    assert(look.value().path() == "/notes")
    assert(look.value().kind() == prism.LookKind.file)
    var collided = false
    let second: interop.Reference[prism.Store]? = prism.Store.open(ipc_db()) catch failure:
        assert(failure.code == prism.busy)
        collided = true
        recover none
    if let extra = second:
        extra.release()
        assert(false)
    assert(collided)

func run_harness() -> !:
    try reset_ipc()
    let exe = try os.executable()
    var cmd = try process.Command(exe, ["owner", ipc_db()])
    defer cmd.close()
    try wait_socket()
    try run_client()
    print("PASS ipc: owner listen, client begin/set/commit/lookup, second open fails flock")

pub func main(arguments: str[]) -> i32!:
    var i: usize = 0
    while i + 1 < arguments.length:
        if arguments[i] == "owner":
            try run_owner(arguments[i + 1])
            return 0
        i += 1
    try run_harness()
    return 0
