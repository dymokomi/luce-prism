## Run under a leak checker: repeated table export must release temporary clones.
import animation

test "repeated table export preserves properties and releases temporary elements":
    var source = model.DocumentData()
    defer source.close()
    try source.add("/users", "directory")
    try source.add("/users/alice", "file")
    var prop = animation.Property()
    defer prop.close()
    prop.name = try Name.of("password-hash")
    prop.type_name = try Name.of("test-property")
    try source.elements.items[1].put_property(&prop)
    let frozen = try from_data(&source)
    defer drop_tables(frozen)
    for iteration in 0..<64:
        _ = iteration
        var exported = try to_data(frozen)
        defer exported.close()
        assert(exported.element_count() == 2)
        assert(try exported.type_at("/users/alice") == "file")
        assert(exported.has_property("/users/alice", "password-hash"))
