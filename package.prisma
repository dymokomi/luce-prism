#prisma 4.0
def package "luce-prism" {
    str owner = "dymokomi"
    str version = "0.5.0"
    str kind = "package"
    str language = "luce-base"
    str description = "Prism's native document engine, written in Luce Base and usable from Luce. It is self-contained: in-memory tables, WAL, an exclusive OS file lock, save/load, and a local owner socket. It does not depend on luce-db."
    str readme = "README.md"
    str[] public = ["persist", "prism", "tables"]

    def dependency "luce-tls" {
        str owner = "dymokomi"
        str version = "^0.6.0"
        str path = "../luce-tls"
    }

    def dependency "luce-crypto" {
        str owner = "dymokomi"
        str version = "^0.5.0"
        str path = "../luce-crypto"
    }

    def dependency "luce-std" {
        str owner = "dymokomi"
        str version = "^0.6.0"
        str path = "../luce-std"
    }
}
